{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: Godot C# (incremental)",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/build/Build.ps1"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "open: Godot .NET editor",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/build/OpenEditor.ps1"],
      "dependsOn": "build: Godot C# (incremental)",
      "problemMatcher": []
    }
  ]
}
