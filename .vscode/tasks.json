{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "run: five-day autonomous CLI (600s)",
      "type": "process",
      "command": "${workspaceFolder}/.runtime/python/Scripts/python.exe",
      "args": ["${workspaceFolder}/mcp/game/run_auto.py", "--backend", "cli", "--duration-seconds", "600", "--receipt", "${workspaceFolder}/.runtime/runs/latest-auto-receipt.json"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "build: Godot C# (incremental)",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/build/Build.ps1"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "open: Godot .NET editor",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/build/OpenEditor.ps1"],
      "dependsOn": "build: Godot C# (incremental)",
      "problemMatcher": []
    }
  ]
}
