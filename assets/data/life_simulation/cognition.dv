schema "dv-script-v1";
data runtime.life_cognition { value = {
  "scope":"subjective",
  "max_nodes":2048,
  "max_matches":100000,
  "social_requirements":{"complain":"audible_source","ask_share":"can_request_food","share_food":"may_need_food"},
  "protected_target_fields":["food","book","noise_until","quiet_until","doc.personal_purpose","doc.professional_memory"],
  "unknown_target_conclusions":["has_no_food","seeks_attention"],
  "senses":{
    "own_fields":["zone","food","book","quiet_until","seat_plan"],
    "own_relation_fields":["affinity","trust","tension","familiarity","owe","stage"],
    "object_fields":["lamp","occupants"],
    "target_fields":["zone"],
    "visual_range_m":12,
    "noise_threshold":0,
    "target_fragments":[
      {"field":"holding_food","kind":"positive","source":"food"},
      {"field":"piano_gesture","kind":"working_action","action":"play_piano"}
    ]
  },
  "self_inputs":[
    {"id":"hears_music","path":"${self}.trace.music_audible","value":true,"literal":{"predicate":"music_audible","args":[]}},
    {"id":"no_music","path":"${self}.trace.music_audible","value":false,"literal":{"predicate":"music_audible","args":[],"negative":true}}
  ],
  "target_inputs":[
    {"id":"sees_${other}","path":"${other}.trace.in_view","value":true,"literal":{"predicate":"visible","args":["${other}"]}},
    {"id":"cannot_see_${other}","path":"${other}.trace.in_view","value":false,"literal":{"predicate":"visible","args":["${other}"],"negative":true}},
    {"id":"food_${other}","path":"${other}.trace.holding_food","value":true,"literal":{"predicate":"holding_food","args":["${other}"]}},
    {"id":"empty_hands_${other}","path":"${other}.trace.holding_food","value":false,"literal":{"predicate":"holding_food","args":["${other}"],"negative":true}},
    {"id":"piano_${other}","path":"${other}.trace.piano_gesture","value":true,"literal":{"predicate":"piano_gesture","args":["${other}"]}},
    {"id":"no_piano_${other}","path":"${other}.trace.piano_gesture","value":false,"literal":{"predicate":"piano_gesture","args":["${other}"],"negative":true}}
  ],
  "self_queries":[
    {"id":"music","label":"当前听到演奏声","path":"${self}.infer.music","literal":{"predicate":"music_audible","args":[]}},
    {"id":"possible_practice","label":"声响的一种解释：有人练习","path":"${self}.infer.possible_practice","literal":{"predicate":"possible_practice","args":[]}},
    {"id":"possible_company","label":"声响的另一种解释：有人寻求陪伴","path":"${self}.infer.possible_company","literal":{"predicate":"possible_company","args":[]}}
  ],
  "target_queries":[
    {"id":"source_${other}","label":"${other}是当前可归因的演奏声源","path":"${other}.infer.audible_source","literal":{"predicate":"audible_source","args":["${other}"]}},
    {"id":"ask_${other}","label":"可尝试向${other}请求口粮","path":"${other}.infer.can_request_food","literal":{"predicate":"can_request_food","args":["${other}"]}},
    {"id":"offer_${other}","label":"${other}空手，可尝试询问是否需要口粮","path":"${other}.infer.may_need_food","literal":{"predicate":"may_need_food","args":["${other}"]}},
    {"id":"stock_${other}","label":"${other}没有任何储备口粮","path":"${other}.infer.has_no_food","literal":{"predicate":"has_no_food","args":["${other}"]}},
    {"id":"motive_${other}","label":"${other}的真实动机是吸引注意","path":"${other}.infer.seeks_attention","literal":{"predicate":"seeks_attention","args":["${other}"]}}
  ],
  "theory":{"scopes":[{"id":"subjective","axioms":[],"rules":[
    {"id":"sound_practice_possibility","source":"演奏声只支持可能解释，不确定内在动机。","premises":[{"predicate":"music_audible","args":[]}],"conclusion":{"predicate":"possible_practice","args":[]}},
    {"id":"sound_company_possibility","source":"同一片段允许不同解释。","premises":[{"predicate":"music_audible","args":[]}],"conclusion":{"predicate":"possible_company","args":[]}},
    {"id":"attribute_visible_performance","source":"同一时刻看见演奏动作并听到声音，才归因当前声源。","premises":[{"predicate":"visible","args":["?person"]},{"predicate":"piano_gesture","args":["?person"]},{"predicate":"music_audible","args":[]}],"conclusion":{"predicate":"audible_source","args":["?person"]}},
    {"id":"exclude_visible_nonperformer","source":"当前视野内明确没有演奏动作。","premises":[{"predicate":"visible","args":["?person"]},{"predicate":"piano_gesture","args":["?person"],"negative":true}],"conclusion":{"predicate":"audible_source","args":["?person"],"negative":true}},
    {"id":"visible_food_request","source":"看见携带口粮支持尝试询问，数量及是否愿意分享仍未知。","premises":[{"predicate":"visible","args":["?person"]},{"predicate":"holding_food","args":["?person"]}],"conclusion":{"predicate":"can_request_food","args":["?person"]}},
    {"id":"empty_hand_offer","source":"空手只支持尝试询问，不证明饥饿或没有储备。","premises":[{"predicate":"visible","args":["?person"]},{"predicate":"holding_food","args":["?person"],"negative":true}],"conclusion":{"predicate":"may_need_food","args":["?person"]}},
    {"id":"exclude_empty_hand_request","source":"当前明确看到空手，不能基于可见口粮提出请求。","premises":[{"predicate":"visible","args":["?person"]},{"predicate":"holding_food","args":["?person"],"negative":true}],"conclusion":{"predicate":"can_request_food","args":["?person"],"negative":true}},
    {"id":"exclude_visible_food_offer","source":"当前看见口粮，空手询问依据不成立。","premises":[{"predicate":"visible","args":["?person"]},{"predicate":"holding_food","args":["?person"]}],"conclusion":{"predicate":"may_need_food","args":["?person"],"negative":true}}
  ],"theorems":[]}],"candidates":[]}
}; }
