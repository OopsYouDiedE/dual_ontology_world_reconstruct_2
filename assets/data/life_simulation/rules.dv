    "lines": {
      "request": {
        "greet": [
          "早啊,{t}。",
          "{t},你好。"
        ],
        "chat": [
          "{t},聊两句?",
          "最近怎么样,{t}?"
        ],
        "ask_info": [
          "{t},问你件事。",
          "请问,你知道这附近……"
        ],
        "confide": [
          "{t},我有点心事想说说。",
          "{t},能听我讲讲吗?"
        ],
        "ask_share": [
          "{t},你那份能分我一点吗?",
          "我饿得不行了,{t}。"
        ],
        "ask_seat": [
          "{t},能不能把位置让给我?",
          "{t},我想用这个。"
        ],
        "invite": [
          "{t},过来一起坐坐吧。",
          "一起歇会儿?"
        ],
        "complain": [
          "{t},能不能小声点?",
          "{t},你太吵了!"
        ],
        "tease": [
          "{t},你这副样子可真有趣。",
          "哟,{t},又在磨蹭?"
        ]
      },
      "reply": {
        "accept": [
          "好啊。",
          "没问题。",
          "当然可以。"
        ],
        "conditional": [
          "可以,不过下次轮到你。",
          "行,但你得答应我一件事。"
        ],
        "defer": [
          "等会儿吧,我现在顾不上。",
          "嗯……待会再说。"
        ],
        "decline": [
          "抱歉,这次不方便。",
          "不好意思,我想自己待会儿。"
        ],
        "ignore": [
          "(没有回应)",
          "(转过头去)"
        ],
        "confront": [
          "别来烦我!",
          "你凭什么这样要求我?"
        ],
        "comply": [
          "可以，但我并不情愿。"
        ],
        "refuse": [
          "不，这件事我不答应。"
        ]
      }
    }
