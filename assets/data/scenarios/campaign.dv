        { source = "res://assets/data/scenarios/social-schemes.dv"; days = [5]; }
    ];
    planning = { source = "res://assets/data/scenarios/detective-planning.dv"; definition = "runtime.character_planning"; };
    scenario_label = "安眠者有福 · 前五日";
    presentation = {
        host = "campaign_rooms";
        source = "res://assets/data/presentation/campaign_rooms.dv";
        definition = "campaign.rooms";
        receipt_directory = "res://artifacts/five-day/godot";
    };
    autonomy_phase = {
        start_minutes = 5760;
        label = "自主观察日";
        description = "各人依据已经知道的事、身体需要与自己的责任安排生活。";
        task_guidance = false;
    };
    run = { end_minutes = 7200; };
    completion = {
        mode = "observation_window";
        end_minutes = 7200;
        label = "第五日观察结束";
    };
}; }
