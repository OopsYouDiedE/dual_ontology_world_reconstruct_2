        { source = "res://assets/data/scenarios/day3.dv"; offset_minutes = 2880; },
        { source = "res://assets/data/scenarios/day4.dv"; offset_minutes = 4320; },
        { source = "res://assets/data/scenarios/day5.dv"; offset_minutes = 5760; }
    ];
    shared_sources = [
        { source = "res://assets/data/scenarios/daily-life.dv"; days = [1]; },
        { source = "res://assets/data/scenarios/life-lucian-gu.dv"; days = [1]; },
        { source = "res://assets/data/scenarios/life-quer-ward.dv"; days = [1]; },
        { source = "res://assets/data/scenarios/life-detective-huo.dv"; days = [1]; },
        { source = "res://assets/data/scenarios/life-shen-su.dv"; days = [1]; },
        { source = "res://assets/data/scenarios/life-selma-ruan.dv"; days = [1]; },
        { source = "res://assets/data/scenarios/life-elena-moran.dv"; days = [1]; },
        { source = "res://assets/data/scenarios/life-veronica-bertrand.dv"; days = [1]; },
        { source = "res://assets/data/scenarios/life-margaret-mora.dv"; days = [1]; },
        { source = "res://assets/data/scenarios/life-demon.dv"; days = [1]; },
        { source = "res://assets/data/scenarios/open-day5-lucian-gu.dv"; days = [5]; },
        { source = "res://assets/data/scenarios/open-day5-quer-ward.dv"; days = [5]; },
        { source = "res://assets/data/scenarios/open-day5-detective-huo.dv"; days = [5]; },
        { source = "res://assets/data/scenarios/open-day5-shen-su.dv"; days = [5]; },
        { source = "res://assets/data/scenarios/open-day5-selma-ruan.dv"; days = [5]; },
        { source = "res://assets/data/scenarios/open-day5-elena-moran.dv"; days = [5]; },
