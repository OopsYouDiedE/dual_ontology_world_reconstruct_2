schema "dv-script-v1";
data runtime.character_session {"value": {
  "compact": true,
  "actor_defaults": {"autonomy":{"commodity_needs":{"curiosity":65,"purpose":60,"agency":65},"need_decay_per_second":{"curiosity":0.001,"purpose":0.0008,"agency":0.0005},"autonomy_weights":{"curiosity":1,"purpose":1,"agency":1}}},
  "facts": {"lucian.doc.professional_memory":"我在欧洲的旧沙龙里学过十四行诗。格律能让人愿意听下去，却不能替证词作保。","lucian.doc.personal_purpose":"别人可以笑我的诗，不能因为雀儿没有家世，就把她的同意也一并收走。","lucian.phys.life_water_pending":false,"lucian.doc.life_water_origin":"","lucian.doc.profession_offered":false,"lucian.doc.profession_offer_room":"","lucian.phys.professional_sessions":0,"lucian.doc.self_directed_today":false,"gu.doc.professional_memory":"从前校碑，最怕抄手把一个看不清的字补得太漂亮。缺处须留缺，传闻须写明从谁而来。","gu.doc.personal_purpose":"我要留下能够复查的原件；哪怕记录会使眼前的同伴难堪，也不能为了和气改掉。","gu.phys.life_water_pending":false,"gu.doc.life_water_origin":"","gu.doc.profession_offered":false,"gu.doc.profession_offer_room":"","gu.phys.professional_sessions":0,"gu.doc.self_directed_today":false,"quer.doc.professional_memory":"旧锁会骗人，手里的阻力不会。摸到哪一针卡住，就先记哪一针，别把猜测当成锁已经开了。","quer.doc.personal_purpose":"我要握住自己的工具和答应别人的权利；愿意帮忙，不等于谁能替我一直答应。","quer.phys.life_water_pending":false,"quer.doc.life_water_origin":"","quer.doc.profession_offered":false,"quer.doc.profession_offer_room":"","quer.phys.professional_sessions":0,"quer.doc.self_directed_today":false,"ward.doc.professional_memory":"过去办案时，一张收据可以说明东西经过谁的手，却不能说明那个人有权替所有人签字。","ward.doc.personal_purpose":"我要让领用和危险作业有责任人，也希望程序经过我的见证；混乱一旦伤人，迟来的善意无用。","ward.phys.life_water_pending":false,"ward.doc.life_water_origin":"","ward.doc.profession_offered":false,"ward.doc.profession_offer_room":"","ward.phys.professional_sessions":0,"ward.doc.self_directed_today":false,"detective.doc.professional_memory":"旧案里最危险的往往是一句过早的“已经明白”。能解释现有痕迹的说法，还要经得起别的解释。","detective.doc.personal_purpose":"我要找到能被反驳和复查的解释，让别人的选择有真实依据。","detective.phys.life_water_pending":false,"detective.doc.life_water_origin":"","detective.doc.profession_offered":false,"detective.doc.profession_offer_room":"","detective.phys.professional_sessions":0,"detective.doc.self_directed_today":false,"huo.doc.professional_memory":"矿井里的回水锤响过一次，整条管线都可能留下假读数。先看隔离边界，再谈把阀开到哪一档。","huo.doc.personal_purpose":"我要把危险关在可检查的机械边界里，也想弄清旧矿井的压力读数为什么会彼此矛盾。","huo.phys.life_water_pending":false,"huo.doc.life_water_origin":"","huo.doc.profession_offered":false,"huo.doc.profession_offer_room":"","huo.phys.professional_sessions":0,"huo.doc.self_directed_today":false,"shen.doc.professional_memory":"船上做饭，水要算给锅，也要算给人。厨子记得每张嘴，不代表能替每个人决定他该受什么苦。","shen.doc.personal_purpose":"我要让伤员和忙碌的人吃到热饭；谁想拿孩子和伤员换一份漂亮结论，我就拦着。","shen.phys.life_water_pending":false,"shen.doc.life_water_origin":"","shen.doc.profession_offered":false,"shen.doc.profession_offer_room":"","shen.phys.professional_sessions":0,"shen.doc.self_directed_today":false,"su.doc.professional_memory":"从前校律，先闭眼听空管，再听有音的那支。知道标签之后，耳朵很容易替猜测找一个音。","su.doc.personal_purpose":"我想弄明白耳中的声响，但解释属于我，继续或停下也应由我自己说。","su.phys.life_water_pending":false,"su.doc.life_water_origin":"","su.doc.profession_offered":false,"su.doc.profession_offer_room":"","su.phys.professional_sessions":0,"su.doc.self_directed_today":false,"selma.doc.professional_memory":"做野外记录时，环境和观察者都在变。今天没看见的东西，不能填成它从未出现。","selma.doc.personal_purpose":"我想理解岛上的变化，也想保住眼前的人，不能为了一个新分类丢掉观察对象的生活。","selma.phys.life_water_pending":false,"selma.doc.life_water_origin":"","selma.doc.profession_offered":false,"selma.doc.profession_offer_room":"","selma.phys.professional_sessions":0,"selma.doc.self_directed_today":false,"ruan.doc.professional_memory":"在棋院拆棋，落子后的形状不能冒充落子前就知道的事。看别人肯付什么代价，比听他自称重什么更准。","ruan.doc.personal_purpose":"我要试出他人真正肯守的边界，争取判断上的先手；路被堵住，就借堵路的人留下的新条件。","ruan.phys.life_water_pending":false,"ruan.doc.life_water_origin":"","ruan.doc.profession_offered":false,"ruan.doc.profession_offer_room":"","ruan.phys.professional_sessions":0,"ruan.doc.self_directed_today":false,"elena.doc.professional_memory":"过去排练吊台，台下的人只看最后一次掌声，台上的人知道哪根绳早半拍就会伤人。","elena.doc.personal_purpose":"我要重新掌握自己的身体与工作；帮助可以接受，把我预先算作代价不行。","elena.phys.life_water_pending":false,"elena.doc.life_water_origin":"","elena.doc.profession_offered":false,"elena.doc.profession_offer_room":"","elena.phys.professional_sessions":0,"elena.doc.self_directed_today":false,"moran.doc.professional_memory":"画室里的互补色会替邻色染边。我能把看到的紫金色画下来，却不能凭颜色替危险定量。","moran.doc.personal_purpose":"我想保住那一瞬的形状；别人看不到的东西，不该立刻被算成我的错觉。","moran.phys.life_water_pending":false,"moran.doc.life_water_origin":"","moran.doc.profession_offered":false,"moran.doc.profession_offer_room":"","moran.phys.professional_sessions":0,"moran.doc.self_directed_today":false,"veronica.doc.professional_memory":"从前配药，漂亮的一次成功不能抵掉前面的失败。对照、原始记录和样本授权必须分开留。","veronica.doc.personal_purpose":"我要得到能重复的结果，证明方法有效；我也会想争取更多试验空间，直到有人把边界问清。","veronica.phys.life_water_pending":false,"veronica.doc.life_water_origin":"","veronica.doc.profession_offered":false,"veronica.doc.profession_offer_room":"","veronica.phys.professional_sessions":0,"veronica.doc.self_directed_today":false,"bertrand.doc.professional_memory":"从前撤伤员，最壮的人也可能在第二段坡倒下。把撤退路留出来，比答应一句“我扛得住”可靠。","bertrand.doc.personal_purpose":"我要让弱者有退路，不把他们的沉默当服从；若别人替我挡了一回，也要有机会还上。","bertrand.phys.life_water_pending":false,"bertrand.doc.life_water_origin":"","bertrand.doc.profession_offered":false,"bertrand.doc.profession_offer_room":"","bertrand.phys.professional_sessions":0,"bertrand.doc.self_directed_today":false,"margaret.doc.professional_memory":"老工地上的木楔会留下受力方向。图上画得稳，不如把卸载顺序写到下一班能看懂。","margaret.doc.personal_purpose":"我要留下别人也能接手的安全结构，不能让一人的豪勇成了所有人的承重墙。","margaret.phys.life_water_pending":false,"margaret.doc.life_water_origin":"","margaret.doc.profession_offered":false,"margaret.doc.profession_offer_room":"","margaret.phys.professional_sessions":0,"margaret.doc.self_directed_today":false,"mora.doc.professional_memory":"从前看病，病人说不痛了与伤已经好是两件事。护理先听本人说，实验同意也不能沿用上一次。","mora.doc.personal_purpose":"我要先照顾已经受伤的人；研究可以谈，但不能让等待检查的人被记成自愿提供样本。","mora.phys.life_water_pending":false,"mora.doc.life_water_origin":"","mora.doc.profession_offered":false,"mora.doc.profession_offer_room":"","mora.phys.professional_sessions":0,"mora.doc.self_directed_today":false,"lucian.doc.exchange_gu_received":false,"lucian.doc.exchange_gu_considered":false,"lucian.doc.exchange_su_received":false,"lucian.doc.exchange_su_considered":false,"gu.doc.exchange_ward_received":false,"gu.doc.exchange_ward_considered":false,"gu.doc.exchange_selma_received":false,"gu.doc.exchange_selma_considered":false,"quer.doc.exchange_huo_received":false,"quer.doc.exchange_huo_considered":false,"quer.doc.exchange_lucian_received":false,"quer.doc.exchange_lucian_considered":false,"ward.doc.exchange_gu_received":false,"ward.doc.exchange_gu_considered":false,"ward.doc.exchange_detective_received":false,"ward.doc.exchange_detective_considered":false,"detective.doc.exchange_ruan_received":false,"detective.doc.exchange_ruan_considered":false,"detective.doc.exchange_gu_received":false,"detective.doc.exchange_gu_considered":false,"detective.doc.exchange_mora_received":false,"detective.doc.exchange_mora_considered":false,"huo.doc.exchange_margaret_received":false,"huo.doc.exchange_margaret_considered":false,"huo.doc.exchange_veronica_received":false,"huo.doc.exchange_veronica_considered":false,"shen.doc.exchange_mora_received":false,"shen.doc.exchange_mora_considered":false,"shen.doc.exchange_huo_received":false,"shen.doc.exchange_huo_considered":false,"su.doc.exchange_elena_received":false,"su.doc.exchange_elena_considered":false,"su.doc.exchange_veronica_received":false,"su.doc.exchange_veronica_considered":false,"selma.doc.exchange_mora_received":false,"selma.doc.exchange_mora_considered":false,"selma.doc.exchange_gu_received":false,"selma.doc.exchange_gu_considered":false,"ruan.doc.exchange_detective_received":false,"ruan.doc.exchange_detective_considered":false,"ruan.doc.exchange_ward_received":false,"ruan.doc.exchange_ward_considered":false,"elena.doc.exchange_su_received":false,"elena.doc.exchange_su_considered":false,"elena.doc.exchange_margaret_received":false,"elena.doc.exchange_margaret_considered":false,"moran.doc.exchange_su_received":false,"moran.doc.exchange_su_considered":false,"moran.doc.exchange_selma_received":false,"moran.doc.exchange_selma_considered":false,"veronica.doc.exchange_mora_received":false,"veronica.doc.exchange_mora_considered":false,"veronica.doc.exchange_huo_received":false,"veronica.doc.exchange_huo_considered":false,"bertrand.doc.exchange_margaret_received":false,"bertrand.doc.exchange_margaret_considered":false,"bertrand.doc.exchange_mora_received":false,"bertrand.doc.exchange_mora_considered":false,"margaret.doc.exchange_huo_received":false,"margaret.doc.exchange_huo_considered":false,"margaret.doc.exchange_quer_received":false,"margaret.doc.exchange_quer_considered":false,"mora.doc.exchange_veronica_received":false,"mora.doc.exchange_veronica_considered":false,"mora.doc.exchange_shen_received":false,"mora.doc.exchange_shen_considered":false,"lucian.phys.served_meal":0,"gu.phys.served_meal":0,"quer.phys.served_meal":0,"ward.phys.served_meal":0,"detective.phys.served_meal":0,"huo.phys.served_meal":0,"shen.phys.served_meal":0,"su.phys.served_meal":0,"selma.phys.served_meal":0,"ruan.phys.served_meal":0,"elena.phys.served_meal":0,"moran.phys.served_meal":0,"veronica.phys.served_meal":0,"bertrand.phys.served_meal":0,"margaret.phys.served_meal":0,"mora.phys.served_meal":0,"elena.phys.clinic_wait_rounds":0,"moran.phys.clinic_wait_rounds":0,"bertrand.phys.clinic_wait_rounds":0,"lecture.doc.scope_lesson":"答复只涵盖所问的对象、条件与时点。接管一件物品，不自动取得处分权；见证一人的签字，也不能代替另一人的同意。","lecture.doc.posted":false,"lecture.doc.requested":false,"gu.doc.steward_question_delivered":false,"ward.doc.steward_question_delivered":false,"ruan.doc.steward_question_delivered":false,"detective.doc.steward_question_delivered":false,"lucian.doc.steward_question_delivered":false,"veronica.doc.steward_question_delivered":false,"selma.doc.steward_question_delivered":false},
