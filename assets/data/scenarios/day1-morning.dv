    ],
      "rules": [
        {"when":{"B_foyer.trace.observation":"门口有两种鞋印与拖擦痕；自恢复门就在乙区厅内","su_instrument.trace.observation":"右袖破损、鞋跟擦痕、琴盒黄铜高音弦断裂；昨夜动作没有记忆","B_gate.trace.observation":"工具包里有曲柄销，门锁反扣且副栓到二档；本人不记得操作","B_kitchen.trace.observation":"小厨房挂钩上有湿麻布仍在滴水，袖口潮湿；不知道谁挂回去","detective.phys.right_hand":"手背抓痕与细丝擦伤"},"then":{"detective.infer.question_direction":true},"basis":{"facts":"手背抓痕、门内鞋印和三人的破袖、断弦、曲柄销、湿布报告","excluded":"防卫和冲突都未排除；缺乏动机不是反证","conclusion":"动机解释相互冲突，先用方向和叠压重建动作","question":"鞋印、袖口受力与门结构是否支持拖回？"}},
        {"when":{"B_case.infer.drag_direction_supported":true,"su.phys.gap_question":"若门会回弹，门底缝隙后来怎么处理？"},"then":{"detective.infer.question_threshold":true},"basis":{"facts":"苏泠听到拖回分析后问及门底缝隙","excluded":"门会回弹不等于当时完全密封","conclusion":"门底是否被另行堵住需要物证","question":"检查门槛水渍和擦痕的叠压关系"}},
        {"when":{"B_threshold.trace.overlay":"水渍麻纤维叠压拖拽痕；当前向外气流","B_threshold.trace.wedge":"门底留有削制软木楔；不能单凭刀痕唯一确认操作者"},"then":{"detective.infer.question_lock":true},"basis":{"facts":"水渍麻纤维叠压拖拽痕；当前向外气流","excluded":"当前正压不证明昨夜始终正压；水渍也不能单独确定操作者","conclusion":"在未再扰动条件下，湿布处理晚于拖拽获得支持","question":"锁具处理在湿布之前还是之后？"}},
        {"when":{"B_kitchen.trace.cloth_origin":"湿布折缝含与门槛相符的石灰岩粗粒与紫金微晶","B_kitchen.trace.containers":"未使用的盆桶锅碗内壁干燥覆尘；沈鼎今晨用过的水杯单独标记，不能把它算作未用容器","B_corridor.trace.floor_dust":"门槛至挂钩的石粉带未见连续滴点、擦拭或拖抹痕；人物今晨足迹另行标记","B_kitchen.trace.containers_before_use":"沈鼎接水前，看见敞放的盆桶杯碗内壁干燥覆尘；今晨只取用自己的水杯"},"then":{"detective.infer.question_paths":true,"B_case.infer.cloth_moved_without_floor_trace":true},"basis":{"facts":"折缝微晶、使用前后的干尘容器和完整石粉带","excluded":"排除已检查容器搬运、厨房重湿和沿途擦地的解释；未穷尽未知器具","conclusion":"湿布从门底移到挂钩，现有地面未留下对应搬运痕迹","question":"检查门窗与通风口的常规进出通路"}},
        {"when":{"island_meeting.phys.compared":true,"central_pillar.doc.fixtures":"中翼传声立柱上有黄铜铭牌、留声匣和交接册"},"then":{"detective.infer.question_contract":true},"basis":{"facts":"四区报告都存在本人无法回忆的异常；立柱上可见契约铭牌","excluded":"相似异常不能单凭外观证明同一超自然操作者","conclusion":"需要查明学院规则及记忆处置是否有记录","question":"读眼前铜牌，核实谁有何种权限"}},
        {"when":{"central_pillar.doc.contract":"第1条四锚职责；第4条授权封存；第5条清场和字面真话；第6条不得拘禁；第7条具体险情知情判断；第9条风窗需09至17且压差实测达标"},"then":{"detective.infer.question_consent":true},"basis":{"facts":"条文规定记忆授权与清场权限","excluded":"条文只说明约定，不能证明实际同意与执行","conclusion":"授权是否发生需要独立记录","question":"播放同一立柱的留声匣"}},
        {"when":{"central_pillar.doc.consent_audio":"录音中十六人依次同意，声纹与本人当前样本相符；不是不可伪造证明","central_pillar.doc.warning_audio":"留声记录包含警告原音，与管内微晶样本复现畸变对照；不能由失忆者回忆"},"then":{"detective.infer.question_account":true},"basis":{"facts":"授权声音与当前样本相符，警告录音与微晶实验可对照","excluded":"声纹不是不可伪造证明；这也不是恢复昨夜记忆","conclusion":"授权记录与异常感知存在相关线索","question":"读取同台交接册，核对执行者自述"}},
        {"when":{"north_stair_2F.lock.closed":true,"north_stair_2F.lock.label":"四锚联锁未复位，当前无法进入上层","direction_sign.doc.monitor":"联锁铭牌箭头指向一楼北侧竖井监测壁龛"},"then":{"detective.infer.question_monitor":true},"basis":{"facts":"闸未开；铭牌写明四锚联锁并标出监测壁龛方向","excluded":"无法上楼不代表导师死亡或四锚失效","conclusion":"需核实阻挡原因与当前四锚状态","question":"按铭牌箭头去看仪表和日志"}},
        {"when":{"shaft_niche_1F.doc.active":true,"shaft_niche_1F.doc.log":"23:31故障断路；23:55四锚闭合另有记录"},"then":{"detective.infer.question_steward":true},"basis":{"facts":"当前指针稳定，23:31故障与23:55四锚闭合分属两条记录","excluded":"仪表不能替代对所有历史细节的见证","conclusion":"导师与四锚的联系有仪表和日志支持","question":"通过眼前传声口请求代管者确认去向与风窗条件"}},
        {"when":{"island_meeting.phys.compared":true,"D_gate.trace.port_crust":"丁区外采样孔边缘有紫金结痂被冲破的残环；仅凭残环不能确定昨夜全部读数","su_instrument.trace.observation":"右袖破损、鞋跟擦痕、琴盒黄铜高音弦断裂；昨夜动作没有记忆","central_pillar.doc.warning_audio":"留声记录包含警告原音，与管内微晶样本复现畸变对照；不能由失忆者回忆","central_pillar.trace.pipe_crystals":"传声口附有紫金微晶，原音通过该段管道后出现可复听的高频畸变","A_room.trace.summary":"浸水拓片、剑管缺口、手铐与通风篦撬痕","C_room.trace.summary":"伤踝、掌印、窗网凹痕、剪断绷带","D_room.trace.summary":"撬门痕、钢楔、酸蚀、采样口结痂"},"then":{"island_case.infer.four_zones_prima_distortion":"四区反常物证与警告原音、传声管微晶对照支持源质感知畸变；各人的昨夜体验仍不可直接恢复"},"basis":{"facts":"泡水无焦痕、窗网凹痕、采样孔残环、乙区断弦与拉门；警告原音及传声口微晶对照","excluded":"现场异常已获共同机制支持，仍不把残环单独当成昨夜全部读数","conclusion":"四区异常与源质引起的感知畸变相符","question":"查交接记录核实清场者与授权"}}
      ],
      "wake_at_game_minutes": 420,
      "autonomy": {"commodity_needs":{"comfort":45,"energy":86},"need_decay_per_second":{"energy":0.001}},
      "perceptions": [
        {
          "id": "detective.empty_room",
          "label": "环视卧室，看见书架与衣柜空置",
          "when": {
            "event:detective.wake.done": true,
            "detective.room": "R05"
          },
          "observes": [
            "R05.phys.bare"
          ]
        },
        {
          "id": "detective.entry_scuffs",
          "label": "走过门厅时看见重叠鞋印与擦痕",
          "when": {
            "event:detective.wake.done": true,
            "detective.room": "B-P",
            "detective.spot": "B-P.entry"
          },
          "observes": [
            "B_foyer.trace.observation"
          ]
        },
        {
          "id": "detective.board_comment",
          "label": "读到批注",
          "when": {
            "detective.room": "T01",
            "T01_board.phys.annotated": true
          },
          "observes": [
            "T01_board.doc.steward_comment"
          ]
        },
        {
          "id": "detective.check_supper_visible",
          "label": "在长桌旁闻见蒸气、看见已盛盘的饺子",
          "when": {
            "detective.room": "F03",
            "detective.phys.asleep": false,
            "F03_meal.phys.cooked": true
          },
          "observes": [
            "F03_meal.phys.cooked"
          ],
          "repeat_on_change": true
        },
        {
          "id": "detective.check_skins_visible",
          "label": "看见案板上实际擀好的饺子皮",
          "when": {
            "detective.room": "F03",
            "detective.phys.asleep": false,
            "quer.phys.first_skins": true,
            "margaret.phys.first_skins": true,
            "ruan.phys.first_skins": true
          },
          "observes": [
            "quer.phys.first_skins",
            "margaret.phys.first_skins",
            "ruan.phys.first_skins"
          ],
          "repeat_on_change": true
        }
      ],
      "opinion": {"base_trust":0.2,"threshold":1.55,"evidence_weight":0.4,"cost_aversion":0.6,"risk_aversion":1.2,"values":{"reason":1.4,"care":1.1,"safety":1},"modifiers":[]}
    },
    {
      "id": "huo",
      "name": "霍铎",
      "args": {"home":"R06","zone":"B","hall":"B-P"},
      "home_room": "R06",
      "home_bed": "R06-bed",
      "knows": {"huo.room":"R06","R06.bed_owner":"huo","huo.spot":"R06","huo.phys.asleep":true},
