            "su.doc.concern_huo": true,
            "su.doc.concern_huo_scope": "破袖、拖痕与反扣门锁显示彼此行动方向相反；尚不能确定锁门是救人、阻拦还是加害。"
          },
          "observes": [
            "su.doc.concern_huo",
            "su.doc.concern_huo_scope"
          ],
          "public_completion_text": "苏泠：我的袖子裂了，你的销离了锁。一个人想出去，另一个人把门锁死——若只照今早的样子看，我们很难把彼此当成好人。我想先问清楚，门外到底有什么。",
          "tell": [
            {
              "actor": "huo",
              "fields": [],
              "results": [
                "su.doc.concern_huo",
                "su.doc.concern_huo_scope"
              ],
