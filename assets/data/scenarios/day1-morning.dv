          "tags": [
            "质询",
            "求证"
          ],
          "reason": "本人刚刚看见伤痕或听到对方的现场报告；还不知道感知扭曲能解释多少，先保留一个可核对的疑问。",
          "writes": {
            "mora.doc.concern_veronica": true,
            "mora.doc.concern_veronica_scope": "伤员灼伤与药瓶使用痕迹要求核对处置范围；医疗需要不能代替伤者同意。"
          },
          "observes": [
            "mora.doc.concern_veronica",
            "mora.doc.concern_veronica_scope"
          ],
          "public_completion_text": "茉拉：我先处理伤口。浓度、落点、谁同意过使用，之后逐项核对。救人的打算可以是真的，造成的伤也可以是真的。",
          "tell": [
            {
              "actor": "veronica",
              "fields": [],
              "results": [
                "mora.doc.concern_veronica",
                "mora.doc.concern_veronica_scope"
              ],
              "room": "D-P"
            }
          ]
        }
