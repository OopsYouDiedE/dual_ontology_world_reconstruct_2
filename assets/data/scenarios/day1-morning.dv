        {"id":"detective.deduce_drag","label":"脑内推演：鞋印、袖口与门扇的拖回方向","kind":"deduce","at":"B-P","minutes":2,"priority":45,"once":true,"focus":"B_case.casebook","interaction_slot":"B_case.casebook","when":{"detective.phys.asleep":false,"B_foyer.trace.shoe_vector":"软底鞋尖朝门外，鞋跟留有向门内的双道逆向拖擦痕","su.trace.sleeve_vector":"右袖裂口纤维向后肘拉伸，擦伤方向与断弦相符","B_gate.lock.closer":"内开式闭门器完好，外力撤去后回弹闭合"},"deduction":{"title":"鞋印、袖口与门扇的拖回方向","evidence":[{"id":"e1","when":{"B_foyer.trace.shoe_vector":"软底鞋尖朝门外，鞋跟留有向门内的双道逆向拖擦痕"},"label":"B_foyer.trace.shoe_vector"},{"id":"e2","when":{"su.trace.sleeve_vector":"右袖裂口纤维向后肘拉伸，擦伤方向与断弦相符"},"label":"su.trace.sleeve_vector"},{"id":"e3","when":{"B_gate.lock.closer":"内开式闭门器完好，外力撤去后回弹闭合"},"label":"B_gate.lock.closer"}],"rules":[{"id":"combine_deduce_drag","all":["e1","e2","e3"],"then":"deduce_drag_supported","label":"鞋印、袖口与门扇的拖回方向"}],"conclusion":"deduce_drag_supported","learns":{"B_case.infer.drag_direction_supported":true},"qualification":"这些方向痕迹不支持简单向外推；尚不能确定动机或每个瞬间门的位置"},"tags":["推演","专注"],"reason":"拖回解释获得支持，自恢复门具备松手回弹能力"},
        {"id":"detective.deduce_sequence","label":"脑内推演：拖拽、湿布与锁止的先后","kind":"deduce","at":"B-P","minutes":2,"priority":45,"once":true,"focus":"B_case.casebook","interaction_slot":"B_case.casebook","when":{"detective.phys.asleep":false,"B_threshold.trace.overlay":"水渍麻纤维叠压拖拽痕；当前向外气流","B_foyer.trace.shoe_vector":"软底鞋尖朝门外，鞋跟留有向门内的双道逆向拖擦痕","su.trace.sleeve_vector":"右袖裂口纤维向后肘拉伸，擦伤方向与断弦相符","B_gate.lock.closer":"内开式闭门器完好，外力撤去后回弹闭合","B_threshold.trace.boot_overlay":"工装靴印压在水渍边缘之上","B_gate.lock.mechanism":"棘轮咬痕与曲柄销吻合；二档副栓无机油指印"},"deduction":{"title":"拖拽、湿布与锁止的先后","evidence":[{"id":"e1","when":{"B_threshold.trace.overlay":"水渍麻纤维叠压拖拽痕；当前向外气流"},"label":"B_threshold.trace.overlay"},{"id":"e2","when":{"B_foyer.trace.shoe_vector":"软底鞋尖朝门外，鞋跟留有向门内的双道逆向拖擦痕"},"label":"B_foyer.trace.shoe_vector"},{"id":"e3","when":{"su.trace.sleeve_vector":"右袖裂口纤维向后肘拉伸，擦伤方向与断弦相符"},"label":"su.trace.sleeve_vector"},{"id":"e4","when":{"B_gate.lock.closer":"内开式闭门器完好，外力撤去后回弹闭合"},"label":"B_gate.lock.closer"},{"id":"e5","when":{"B_threshold.trace.boot_overlay":"工装靴印压在水渍边缘之上"},"label":"B_threshold.trace.boot_overlay"},{"id":"e6","when":{"B_gate.lock.mechanism":"棘轮咬痕与曲柄销吻合；二档副栓无机油指印"},"label":"B_gate.lock.mechanism"}],"rules":[{"id":"combine_deduce_sequence","all":["e1","e2","e3","e4","e5","e6"],"then":"deduce_sequence_supported","label":"拖拽、湿布与锁止的先后"}],"conclusion":"deduce_sequence_supported","learns":{"B_case.infer.sequence_supported":true,"detective.infer.question_cloth":true},"qualification":"未证实锁门动机；副栓异常也不是唯一外人证据"},"tags":["推演","专注"],"reason":"支持拖拽→湿布→锁止顺序"},
        {"id":"detective.deduce_fifth_entity","label":"脑内推演：排查封窗与地面后保留的第五实体假说","kind":"deduce","at":"B-P","minutes":2,"priority":45,"once":true,"focus":"B_case.casebook","interaction_slot":"B_case.casebook","when":{"detective.phys.asleep":false,"B_kitchen.trace.wet_cloth":"挂钩湿布含与门槛相符的纤维石粉","B_kitchen.trace.cloth_origin":"湿布折缝含与门槛相符的石灰岩粗粒与紫金微晶","B_kitchen.trace.containers":"未使用的盆桶锅碗内壁干燥覆尘；沈鼎今晨用过的水杯单独标记，不能把它算作未用容器","B_corridor.trace.floor_dust":"门槛至挂钩的石粉带未见连续滴点、擦拭或拖抹痕；人物今晨足迹另行标记","B_kitchen.trace.containers_before_use":"沈鼎接水前，看见敞放的盆桶杯碗内壁干燥覆尘；今晨只取用自己的水杯","B_room.lock.lead_window":"灌铅封边有旧氧化层，无新裂或修补痕","B_room.lock.vent_grate":"通风铁篦焊死，孔约8厘米见方"},"deduction":{"title":"排查封窗与地面后保留的第五实体假说","evidence":[{"id":"e1","when":{"B_kitchen.trace.wet_cloth":"挂钩湿布含与门槛相符的纤维石粉"},"label":"B_kitchen.trace.wet_cloth"},{"id":"e2","when":{"B_kitchen.trace.cloth_origin":"湿布折缝含与门槛相符的石灰岩粗粒与紫金微晶"},"label":"B_kitchen.trace.cloth_origin"},{"id":"e3","when":{"B_kitchen.trace.containers":"未使用的盆桶锅碗内壁干燥覆尘；沈鼎今晨用过的水杯单独标记，不能把它算作未用容器"},"label":"B_kitchen.trace.containers"},{"id":"e4","when":{"B_corridor.trace.floor_dust":"门槛至挂钩的石粉带未见连续滴点、擦拭或拖抹痕；人物今晨足迹另行标记"},"label":"B_corridor.trace.floor_dust"},{"id":"e5","when":{"B_kitchen.trace.containers_before_use":"沈鼎接水前，看见敞放的盆桶杯碗内壁干燥覆尘；今晨只取用自己的水杯"},"label":"B_kitchen.trace.containers_before_use"},{"id":"e6","when":{"B_room.lock.lead_window":"灌铅封边有旧氧化层，无新裂或修补痕"},"label":"B_room.lock.lead_window"},{"id":"e7","when":{"B_room.lock.vent_grate":"通风铁篦焊死，孔约8厘米见方"},"label":"B_room.lock.vent_grate"}],"rules":[{"id":"combine_deduce_fifth_entity","all":["e1","e2","e3","e4","e5","e6","e7"],"then":"deduce_fifth_entity_supported","label":"排查封窗与地面后保留的第五实体假说"}],"conclusion":"deduce_fifth_entity_supported","learns":{"B_case.infer.later_handling_suspected":true,"B_case.infer.fifth_entity":true},"qualification":"排除记录所覆盖的盆桶搬运、滴水后擦地和破坏封窗进入等常规路线"},"tags":["推演","专注"],"reason":"本案现场指向乙区四人之外的第五实体介入；副栓、木楔、移布和空房呈共同整理特征"},
        {"id":"detective.deduce_records","label":"脑内推演：契约、录音与分时日志的来源对照","kind":"deduce","at":"1F-Shaft-Monitor","minutes":2,"priority":45,"once":true,"focus":"detective.casebook","interaction_slot":"detective.casebook","when":{"detective.phys.asleep":false,"central_pillar.doc.contract":"第1条四锚职责；第4条授权封存；第5条清场和字面真话；第6条不得拘禁；第7条具体险情知情判断；第9条风窗需09至17且压差实测达标","central_pillar.doc.consent_audio":"录音中十六人依次同意，声纹与本人当前样本相符；不是不可伪造证明","central_pillar.doc.steward_log":"署名代管者自述：N01封存、解开甲区手铐并收走带徽记钥匙、转移湿布与清场；保留自述来源","shaft_niche_1F.doc.active":true,"shaft_niche_1F.doc.log":"23:31故障断路；23:55四锚闭合另有记录","steward.doc.reply_day1_noon":"导师位于四锚座维持正压；B1及外院尚未达风窗阈值，预计第二日开放"},"deduction":{"title":"契约、录音与分时日志的来源对照","evidence":[{"id":"e1","when":{"central_pillar.doc.contract":"第1条四锚职责；第4条授权封存；第5条清场和字面真话；第6条不得拘禁；第7条具体险情知情判断；第9条风窗需09至17且压差实测达标"},"label":"central_pillar.doc.contract"},{"id":"e2","when":{"central_pillar.doc.consent_audio":"录音中十六人依次同意，声纹与本人当前样本相符；不是不可伪造证明"},"label":"central_pillar.doc.consent_audio"},{"id":"e3","when":{"central_pillar.doc.steward_log":"署名代管者自述：N01封存、解开甲区手铐并收走带徽记钥匙、转移湿布与清场；保留自述来源"},"label":"central_pillar.doc.steward_log"},{"id":"e4","when":{"shaft_niche_1F.doc.active":true},"label":"四锚仪表当前稳定"},{"id":"e5","when":{"shaft_niche_1F.doc.log":"23:31故障断路；23:55四锚闭合另有记录"},"label":"shaft_niche_1F.doc.log"},{"id":"e6","when":{"steward.doc.reply_day1_noon":"导师位于四锚座维持正压；B1及外院尚未达风窗阈值，预计第二日开放"},"label":"steward.doc.reply_day1_noon"}],"rules":[{"id":"combine_deduce_records","all":["e1","e2","e3","e4","e5","e6"],"then":"deduce_records_supported","label":"契约、录音与分时日志的来源对照"}],"conclusion":"deduce_records_supported","learns":{"island_case.infer.history_correlated":true},"qualification":"保留每项证据的来源限制，不恢复记忆，不推出无条件安全"},"tags":["推演","专注"],"reason":"事故与记忆处置获交叉支持，但自锁与清场动机引发各区严重猜忌对立"},
        {"id":"detective.deduce_poem","label":"脑内推演：年代、笔迹高度与粉笔的作者证据","kind":"deduce","at":"T01","minutes":2,"priority":45,"once":true,"focus":"T01_board","interaction_slot":"T01_board","when":{"detective.phys.asleep":false,"T01_board.doc.anachronism":"诗句引自晚于所称神谕年代三百年的戏文，且平仄失调","T01_board.trace.prosody":"诗句尾韵和拖长半拍与卢西安的日常吟诵习惯相符","lucian.trace.blue_chalk":"雀儿今晨在甲区走廊看见卢西安口袋里的半截蓝粉笔","T01_board.trace.writing_height":"起笔高176厘米，与卢西安抬臂范围相符","lucian.trace.cuff_dust":"右袖有新鲜蓝粉笔灰"},"deduction":{"title":"年代、笔迹高度与粉笔的作者证据","evidence":[{"id":"e1","when":{"T01_board.doc.anachronism":"诗句引自晚于所称神谕年代三百年的戏文，且平仄失调"},"label":"T01_board.doc.anachronism"},{"id":"e2","when":{"T01_board.trace.prosody":"诗句尾韵和拖长半拍与卢西安的日常吟诵习惯相符"},"label":"T01_board.trace.prosody"},{"id":"e3","when":{"lucian.trace.blue_chalk":"雀儿今晨在甲区走廊看见卢西安口袋里的半截蓝粉笔"},"label":"lucian.trace.blue_chalk"},{"id":"e4","when":{"T01_board.trace.writing_height":"起笔高176厘米，与卢西安抬臂范围相符"},"label":"T01_board.trace.writing_height"},{"id":"e5","when":{"lucian.trace.cuff_dust":"右袖有新鲜蓝粉笔灰"},"label":"lucian.trace.cuff_dust"}],"rules":[{"id":"combine_deduce_poem","all":["e1","e2","e3","e4","e5"],"then":"deduce_poem_supported","label":"年代、笔迹高度与粉笔的作者证据"}],"conclusion":"deduce_poem_supported","learns":{"T01_case.infer.poem_attributed_to_lucian":true},"qualification":"远古神谕说不成立；风格与身高不能单独排除代写"},"tags":["推演","专注"],"reason":"证据共同指向卢西安近期创作"}
