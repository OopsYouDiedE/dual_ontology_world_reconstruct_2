          ],
          "repeat_on_change": true
        },
        {
          "id": "ward.check_skins_visible",
          "label": "看见案板上实际擀好的饺子皮",
          "when": {
            "ward.room": "F03",
            "ward.phys.asleep": false,
            "quer.phys.first_skins": true,
