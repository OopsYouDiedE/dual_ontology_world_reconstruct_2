        {"id":"margaret.file_S102_report","label":"签署并留下S-102实际巡检记录","kind":"interact","at":"2F-cross-M","minutes":2,"priority":40,"once":true,"focus":"academies.report_board","when":{"margaret.phys.asleep":false,"event:margaret.inspect_S102.done":true,"S102.trace.reference_scale":"仪器台保留机械标尺零点、读数时刻和压差对照表；晶体发亮只是单项显示，未对照机械读数与当前风窗就不能据此判定通路安全。"},"interaction_slot":"academies.report_board","writes":{"S102.doc.signed_report":"玛格丽特签名：开仓后已实查S-102标尺零点与仪器对照，记录必须同时保留位置、时刻和机械读数；晶体亮色不能单独作为安全通行依据。"},"observes":["S102.doc.signed_report"],"tags":["测绘","结构分析"]},
