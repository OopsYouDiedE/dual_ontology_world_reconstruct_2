        {"id":"margaret.to_S102","label":"按专业分工前往星仪院·精密仪器室","kind":"walk","at":"2F-cross-M","minutes":7,"priority":36,"once":false,"focus":"2F-cross-M-door","when":{"margaret.phys.asleep":false,"event:margaret.read_academy_route.done":true,"academies.doc.route":"四院初探登记图：文契W-102纸墨分析与白塔B-102配药室由主楼一层公共横路接入；铁工F-104备件室经二层北横路门前接道进入，星仪S-102精密仪器室由二层星仪接驳内廊进入。四院风窗09:00至17:00，16:30停止出发、16:45停止新作业；已在院内者始终可沿原接驳廊回楼。完成巡检者回二楼中翼签名登记，登记只报告可用设施与限制，不授权拆封院藏或增领物资。","island_environment.phys.wind_window":true},"writes":{"margaret.room":"S-102"},"observes":["margaret.room"],"route_rooms":["2F-cross-M","2F-gallery-E","2F-cross-N","2F-S-return","AC-S-1-return","AC-S-1-cross","AC-S-1-long","S-102"],"requires":{"island_environment.phys.wind_window":true},"unknown":["event:margaret.inspect_S102.done"],"not_after_game_minutes":990,"tags":["测绘","结构分析"]},
        {"id":"margaret.inspect_S102","label":"复核标尺零点和机械读数，记录晶体显示的判断限度","kind":"inspect","at":"S-102","minutes":4,"priority":42,"once":true,"focus":"S102.instruments","when":{"margaret.phys.asleep":false,"academies.doc.route":"四院初探登记图：文契W-102纸墨分析与白塔B-102配药室由主楼一层公共横路接入；铁工F-104备件室经二层北横路门前接道进入，星仪S-102精密仪器室由二层星仪接驳内廊进入。四院风窗09:00至17:00，16:30停止出发、16:45停止新作业；已在院内者始终可沿原接驳廊回楼。完成巡检者回二楼中翼签名登记，登记只报告可用设施与限制，不授权拆封院藏或增领物资。","island_environment.phys.wind_window":true},"interaction_slot":"S102.instruments","requires":{"island_environment.phys.wind_window":true},"not_after_game_minutes":1005,"observes":["S102.trace.reference_scale"],"tags":["测绘","结构分析"]},
