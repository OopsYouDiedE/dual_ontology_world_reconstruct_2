        {"id":"detective.to_S102","label":"循已知通路前往星仪院·精密仪器室（16:30前）","kind":"walk","at":"2F-cross-M","minutes":7,"priority":35,"once":false,"focus":"2F-cross-M-door","when":{"detective.phys.asleep":false,"academies.doc.route":"四院初探登记图：文契W-102纸墨分析与白塔B-102配药室由主楼一层公共横路接入；铁工F-104备件室经二层北横路门前接道进入，星仪S-102精密仪器室由二层星仪接驳内廊进入。四院风窗09:00至17:00，16:30停止出发、16:45停止新作业；已在院内者始终可沿原接驳廊回楼。完成巡检者回二楼中翼签名登记，登记只报告可用设施与限制，不授权拆封院藏或增领物资。","island_environment.phys.wind_window":true,"ration.policy.mediated":true},"writes":{"detective.room":"S-102"},"observes":["detective.room"],"route_rooms":["2F-cross-M","2F-gallery-E","2F-cross-N","2F-S-return","AC-S-1-return","AC-S-1-cross","AC-S-1-long","S-102"],"requires":{"island_environment.phys.wind_window":true},"unknown":["event:detective.inspect_S102.done"],"not_after_game_minutes":990},
        {"id":"detective.inspect_S102","label":"核对仪器零点、记录时刻与压差对照表","kind":"inspect","at":"S-102","minutes":4,"priority":44,"once":true,"focus":"S102.instruments","when":{"detective.phys.asleep":false,"academies.doc.route":"四院初探登记图：文契W-102纸墨分析与白塔B-102配药室由主楼一层公共横路接入；铁工F-104备件室经二层北横路门前接道进入，星仪S-102精密仪器室由二层星仪接驳内廊进入。四院风窗09:00至17:00，16:30停止出发、16:45停止新作业；已在院内者始终可沿原接驳廊回楼。完成巡检者回二楼中翼签名登记，登记只报告可用设施与限制，不授权拆封院藏或增领物资。","island_environment.phys.wind_window":true},"interaction_slot":"S102.instruments","requires":{"island_environment.phys.wind_window":true},"not_after_game_minutes":1005,"observes":["S102.trace.reference_scale"],"tags":["勘验","求证"]},
        {"id":"detective.return_from_S102","label":"沿原接驳廊离开S-102，返回主楼中翼","kind":"walk","at":"S-102","minutes":7,"priority":8,"once":false,"focus":"S-102-door","when":{"detective.phys.asleep":false},"writes":{"detective.room":"2F-cross-M"},"observes":["detective.room"],"route_rooms":["S-102","AC-S-1-long","AC-S-1-cross","AC-S-1-return","2F-S-return","2F-cross-N","2F-gallery-E","2F-cross-M"]},
        {"id":"detective.read_academy_reports","label":"逐份核对四位巡检者的签名、实查地点和资源限制","kind":"read","at":"2F-cross-M","minutes":3,"priority":39,"once":true,"focus":"academies.report_board","when":{"detective.phys.asleep":false,"academies.doc.route":"四院初探登记图：文契W-102纸墨分析与白塔B-102配药室由主楼一层公共横路接入；铁工F-104备件室经二层北横路门前接道进入，星仪S-102精密仪器室由二层星仪接驳内廊进入。四院风窗09:00至17:00，16:30停止出发、16:45停止新作业；已在院内者始终可沿原接驳廊回楼。完成巡检者回二楼中翼签名登记，登记只报告可用设施与限制，不授权拆封院藏或增领物资。","ration.policy.mediated":true},"interaction_slot":"academies.report_board","requires":{"W102.doc.signed_report":"顾平章签名：已实查W-102纸墨台，样墨与旧纸可供比对；借阅登记须对应原页编号，旧签名不扩张授权，也不开放封存原卷。","B102.doc.signed_report":"维罗妮卡签名：已实查B-102药柜与配制台，洁净器具可用但没有新增成药；三份螯合剂原料仍以主粮仓封签清册为准，领用后须实际配制验药。","F104.doc.signed_report":"霍铎签名：开仓后已实查F-104备件成品与止动配合，机械件须按尺寸选用；仓门仍依赖支撑、挑锁和反扣绞盘三种工作，备件不能代替个人专用工具。","S102.doc.signed_report":"玛格丽特签名：开仓后已实查S-102标尺零点与仪器对照，记录必须同时保留位置、时刻和机械读数；晶体亮色不能单独作为安全通行依据。"},"observes":["W102.doc.signed_report","B102.doc.signed_report","F104.doc.signed_report","S102.doc.signed_report"],"tags":["勘验","求证"]},
        {"id":"detective.deduce_academy_resources","label":"脑内推演：把四院现场、空间接驳和封签清册合成可用资源判断","kind":"deduce","at":"2F-cross-M","minutes":4,"priority":48,"once":true,"focus":"academies.report_board","when":{"detective.phys.asleep":false,"event:detective.read_academy_reports.done":true,"W102.trace.paper_register":"纸墨台上可比对旧纸纤维、样墨和刮擦痕；借阅牌要求保留原页与编号，原卷库封签不能凭一张旧签名拆开。","B102.trace.preparation_limits":"洁净药柜只有空瓶、滤布和量具；配制牌写明原料须从已封签粮药清册领用，未制成的螯合剂不能按现成药发放。","F104.trace.parts_fit":"备件台列出棘齿、止动销和垫片的配合尺寸；现成备件只能替换匹配的机械件，不能代替雀儿的精钢探针或霍铎的棘轮扳手。","S102.trace.reference_scale":"仪器台保留机械标尺零点、读数时刻和压差对照表；晶体发亮只是单项显示，未对照机械读数与当前风窗就不能据此判定通路安全。"},"interaction_slot":"academies.report_board","unknown":["detective.infer.academy_resource_limits"],"tags":["推演","专注"],"deduction":{"title":"四院现场与资源使用边界","evidence":[{"id":"academy_routes","when":{"academies.doc.route":"四院初探登记图：文契W-102纸墨分析与白塔B-102配药室由主楼一层公共横路接入；铁工F-104备件室经二层北横路门前接道进入，星仪S-102精密仪器室由二层星仪接驳内廊进入。四院风窗09:00至17:00，16:30停止出发、16:45停止新作业；已在院内者始终可沿原接驳廊回楼。完成巡检者回二楼中翼签名登记，登记只报告可用设施与限制，不授权拆封院藏或增领物资。"},"label":"实读的楼层接驳图与风窗、返程规则"},{"id":"sealed_inventory","when":{"granary.doc.inventory":"粮袋、煤饼与三份螯合剂原料均有封签；按十六人领用逐笔记账"},"label":"实点的主粮仓封签清册与三份药材原料"},{"id":"W102_field","when":{"W102.trace.paper_register":"纸墨台上可比对旧纸纤维、样墨和刮擦痕；借阅牌要求保留原页与编号，原卷库封签不能凭一张旧签名拆开。"},"label":"亲查W-102：纸墨台的旧纸、样墨与借阅边界"},{"id":"W102_report","when":{"W102.doc.signed_report":"顾平章签名：已实查W-102纸墨台，样墨与旧纸可供比对；借阅登记须对应原页编号，旧签名不扩张授权，也不开放封存原卷。"},"label":"顾平章实查后签署的W-102记录"},{"id":"B102_field","when":{"B102.trace.preparation_limits":"洁净药柜只有空瓶、滤布和量具；配制牌写明原料须从已封签粮药清册领用，未制成的螯合剂不能按现成药发放。"},"label":"亲查B-102：药柜的空瓶、量具与未配制标签"},{"id":"B102_report","when":{"B102.doc.signed_report":"维罗妮卡签名：已实查B-102药柜与配制台，洁净器具可用但没有新增成药；三份螯合剂原料仍以主粮仓封签清册为准，领用后须实际配制验药。"},"label":"维罗妮卡实查后签署的B-102记录"},{"id":"F104_field","when":{"F104.trace.parts_fit":"备件台列出棘齿、止动销和垫片的配合尺寸；现成备件只能替换匹配的机械件，不能代替雀儿的精钢探针或霍铎的棘轮扳手。"},"label":"亲查F-104：止动件规格与专用工具配合"},{"id":"F104_report","when":{"F104.doc.signed_report":"霍铎签名：开仓后已实查F-104备件成品与止动配合，机械件须按尺寸选用；仓门仍依赖支撑、挑锁和反扣绞盘三种工作，备件不能代替个人专用工具。"},"label":"霍铎实查后签署的F-104记录"},{"id":"S102_field","when":{"S102.trace.reference_scale":"仪器台保留机械标尺零点、读数时刻和压差对照表；晶体发亮只是单项显示，未对照机械读数与当前风窗就不能据此判定通路安全。"},"label":"亲查S-102：标尺零点与压差对照表"},{"id":"S102_report","when":{"S102.doc.signed_report":"玛格丽特签名：开仓后已实查S-102标尺零点与仪器对照，记录必须同时保留位置、时刻和机械读数；晶体亮色不能单独作为安全通行依据。"},"label":"玛格丽特实查后签署的S-102记录"}],"rules":[{"id":"verify_W102","all":["W102_field","W102_report"],"then":"W102_limits","label":"纸墨比对必须保留原始文本和授权范围"},{"id":"verify_B102","all":["B102_field","B102_report"],"then":"B102_limits","label":"洁净器具不能增加成药份额或替代实际配制"},{"id":"verify_F104","all":["F104_field","F104_report"],"then":"F104_limits","label":"匹配备件只能修机械件，三种专门工作仍不可互相替代"},{"id":"verify_S102","all":["S102_field","S102_report"],"then":"S102_limits","label":"仪器观察必须联系空间位置、时刻与机械对照"},{"id":"combine_academy_limits","all":["academy_routes","sealed_inventory","W102_limits","B102_limits","F104_limits","S102_limits"],"then":"bounded_academy_resources","label":"楼层与风窗限制决定何时能到场，原页、实物、配合与读数限制决定哪些资源真的可用"}],"conclusion":"bounded_academy_resources","learns":{"detective.infer.academy_resource_limits":true,"detective.infer.academies_personally_verified":true},"qualification":"四院均由侦探到场勘查，并与实际巡检者签名记录相互核对；没有增加药材、工具或解封权限。"}},
        {"id":"detective.deduce_academy_reports","label":"关窗后的脑内推演：依据四院签名实查报告限定资源（转述）","kind":"deduce","at":"2F-cross-M","minutes":4,"priority":44,"once":true,"focus":"academies.report_board","when":{"detective.phys.asleep":false,"event:detective.read_academy_reports.done":true,"island_environment.phys.wind_window":false},"interaction_slot":"academies.report_board","requires":{"island_environment.phys.wind_window":false},"unknown":["detective.infer.academy_resource_limits"],"not_before_game_minutes":1021,"tags":["推演","专注"],"deduction":{"title":"关窗后依据签名报告作出的有限判断","evidence":[{"id":"academy_routes","when":{"academies.doc.route":"四院初探登记图：文契W-102纸墨分析与白塔B-102配药室由主楼一层公共横路接入；铁工F-104备件室经二层北横路门前接道进入，星仪S-102精密仪器室由二层星仪接驳内廊进入。四院风窗09:00至17:00，16:30停止出发、16:45停止新作业；已在院内者始终可沿原接驳廊回楼。完成巡检者回二楼中翼签名登记，登记只报告可用设施与限制，不授权拆封院藏或增领物资。"},"label":"实读的楼层接驳图与风窗、返程规则"},{"id":"sealed_inventory","when":{"granary.doc.inventory":"粮袋、煤饼与三份螯合剂原料均有封签；按十六人领用逐笔记账"},"label":"实点的主粮仓封签清册与三份药材原料"},{"id":"W102_report","when":{"W102.doc.signed_report":"顾平章签名：已实查W-102纸墨台，样墨与旧纸可供比对；借阅登记须对应原页编号，旧签名不扩张授权，也不开放封存原卷。"},"label":"转述依据：顾平章的W-102签名记录"},{"id":"B102_report","when":{"B102.doc.signed_report":"维罗妮卡签名：已实查B-102药柜与配制台，洁净器具可用但没有新增成药；三份螯合剂原料仍以主粮仓封签清册为准，领用后须实际配制验药。"},"label":"转述依据：维罗妮卡的B-102签名记录"},{"id":"F104_report","when":{"F104.doc.signed_report":"霍铎签名：开仓后已实查F-104备件成品与止动配合，机械件须按尺寸选用；仓门仍依赖支撑、挑锁和反扣绞盘三种工作，备件不能代替个人专用工具。"},"label":"转述依据：霍铎的F-104签名记录"},{"id":"S102_report","when":{"S102.doc.signed_report":"玛格丽特签名：开仓后已实查S-102标尺零点与仪器对照，记录必须同时保留位置、时刻和机械读数；晶体亮色不能单独作为安全通行依据。"},"label":"转述依据：玛格丽特的S-102签名记录"}],"rules":[{"id":"reported_W102","all":["W102_report"],"then":"W102_limits","label":"按签名实查报告采用有限结论：纸墨比对必须保留原始文本和授权范围"},{"id":"reported_B102","all":["B102_report"],"then":"B102_limits","label":"按签名实查报告采用有限结论：洁净器具不能增加成药份额或替代实际配制"},{"id":"reported_F104","all":["F104_report"],"then":"F104_limits","label":"按签名实查报告采用有限结论：匹配备件只能修机械件，三种专门工作仍不可互相替代"},{"id":"reported_S102","all":["S102_report"],"then":"S102_limits","label":"按签名实查报告采用有限结论：仪器观察必须联系空间位置、时刻与机械对照"},{"id":"combine_academy_limits","all":["academy_routes","sealed_inventory","W102_limits","B102_limits","F104_limits","S102_limits"],"then":"bounded_academy_resources","label":"楼层与风窗限制决定何时能到场，原页、实物、配合与读数限制决定哪些资源真的可用"}],"conclusion":"bounded_academy_resources","learns":{"detective.infer.academy_resource_limits":true,"detective.infer.academies_report_basis":true},"qualification":"依据四名专业巡检者真实到场后留下的签名报告；未亲见的院内细节仍记作转述，没有解锁侦探的现场痕迹知识。"}},
        {"id":"detective.finish_academy_survey","label":"带着四院资源判断回食堂，完成今日分工","kind":"walk","at":"2F-cross-M","minutes":3,"priority":32,"once":true,"focus":"2F-cross-M-door","when":{"detective.phys.asleep":false,"detective.infer.academy_resource_limits":true},"writes":{"detective.room":"F03"},"observes":["detective.room"],"route_rooms":["2F-cross-M","F03"],"completion_lines":[{"when":{"op":"equals","ref":{"type":"ref","object":"event:detective.finish_academy_survey","facet":"state","field":"done"},"value":true},"text":"案卷旁记：四院的器具各有用处，也各有边界。分工写下了，下一次交接时，还要看我们肯不肯照着做。"}]},
        {"id":"detective.pause_academy_survey","label":"暂缓踏查，沿主楼公共通路返回食堂","kind":"walk","at":"2F-cross-M","minutes":3,"priority":32,"once":false,"focus":"2F-cross-M-door","when":{"detective.phys.asleep":false,"ration.policy.mediated":true,"academies.doc.route":"四院初探登记图：文契W-102纸墨分析与白塔B-102配药室由主楼一层公共横路接入；铁工F-104备件室经二层北横路门前接道进入，星仪S-102精密仪器室由二层星仪接驳内廊进入。四院风窗09:00至17:00，16:30停止出发、16:45停止新作业；已在院内者始终可沿原接驳廊回楼。完成巡检者回二楼中翼签名登记，登记只报告可用设施与限制，不授权拆封院藏或增领物资。"},"writes":{"detective.room":"F03"},"observes":["detective.room"],"route_rooms":["2F-cross-M","F03"],"unknown":["detective.infer.academy_resource_limits"],"manual_only":true},
        {"id":"detective.to_supper","label":"前往一楼大食堂","kind":"walk","at":"F03","minutes":3,"priority":26,"once":true,"focus":"detective","when":{"detective.phys.asleep":false,"ration.policy.mediated":true,"detective.infer.academy_resource_limits":true},"writes":{"detective.room":"F03"},"observes":["detective.room"],"route_rooms":["F03","F03"],"not_before_game_minutes":1080,"perceived_need_effects":{"hunger":25,"social":10},"tags":["用餐"]},
        {"id":"detective.eat_supper","label":"在餐桌上领取一份热食，与同伴吃完晚餐","kind":"interact","at":"F03","minutes":12,"priority":34,"once":true,"focus":"F03-table","interaction_slot":"F03-seat-detective","when":{"detective.phys.asleep":false,"event:detective.to_supper.done":true,"meal_day2.phys.ready":true},"requires":{"meal_day2.phys.ready":true},"writes":{"meal_day2_detective.phys.consumed":true},"observes":["meal_day2_detective.phys.consumed"],"perceived_need_effects":{"hunger":75,"comfort":20,"social":20,"thirst":40},"completed_need_effects":{"hunger":75,"comfort":20,"social":20,"thirst":40},"add_buffs":["buff_warm_porridge"],"emotion":"安心","tags":["用餐"]},
        {"id":"detective.return_bed","label":"前往R05","kind":"walk","at":"F03","minutes":3,"priority":32,"once":true,"focus":"detective","when":{"detective.phys.asleep":false,"event:detective.eat_supper.done":true},"writes":{"detective.room":"R05"},"observes":["detective.room"],"route_rooms":["F03","R05"],"not_before_game_minutes":1260},
        {"id":"detective.sleep_night","label":"洗漱后躺回自己的床，安眠至翌晨","kind":"interact","at":"R05","minutes":2,"priority":50,"once":true,"focus":"R05-bed","interaction_slot":"R05-bed","when":{"detective.phys.asleep":false,"event:detective.return_bed.done":true,"ration.policy.mediated":true},"writes":{"detective.phys.asleep":true},"observes":["detective.phys.asleep"],"emotion":"睡眠","tags":["睡眠"],"perceived_need_effects":{"energy":85},"completed_need_effects":{"energy":85}},
        {"id":"detective.rest_0","label":"稍作歇息，等待手边工作可以继续","kind":"interact","at":"F03","minutes":8,"priority":-12,"once":false,"focus":"detective","interaction_slot":"detective","when":{"detective.phys.asleep":false},"need_below":{"energy":35},"perceived_need_effects":{"energy":25},"completed_need_effects":{"energy":25},"tags":["休息"]},
        {"id":"detective.rest_1","label":"稍作歇息，等待手边工作可以继续","kind":"interact","at":"R05","minutes":8,"priority":-12,"once":false,"focus":"detective","interaction_slot":"detective","when":{"detective.phys.asleep":false},"need_below":{"energy":35},"perceived_need_effects":{"energy":25},"completed_need_effects":{"energy":25},"tags":["休息"]}
      ],
      "perceptions": [
        {
          "id": "detective.wind_open",
          "label": "听见正式开窗钟，检查眼前风窗指示",
          "when": {
            "detective.room": "1F-Shaft-Monitor",
            "detective.phys.asleep": false,
            "island_environment.phys.wind_window": true
          },
          "observes": [
            "island_environment.phys.wind_window"
          ]
        },
        {
          "id": "detective.open_granary",
          "label": "看见粮仓门已经打开",
          "when": {
            "detective.room": "U01-granary",
            "detective.phys.asleep": false,
            "granary.lock.open": true
          },
          "observes": [
            "granary.lock.open"
          ]
        },
        {
