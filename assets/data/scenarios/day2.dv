        {"id":"detective.morning_care","label":"饮水洗漱，整理随身器具","kind":"interact","at":"R05","minutes":6,"priority":22,"once":true,"focus":"R05-basin","interaction_slot":"R05-basin","when":{"detective.phys.asleep":false,"event:detective.wake.done":true},"perceived_need_effects":{"thirst":35,"hygiene":40,"comfort":15},"completed_need_effects":{"thirst":35,"hygiene":40,"comfort":15},"tags":["自护","清洁"]},
        {"id":"detective.to_monitor","label":"前往一楼竖井监测壁龛","kind":"walk","at":"R05","minutes":3,"priority":32,"once":true,"focus":"detective","when":{"detective.phys.asleep":false,"event:detective.morning_care.done":true},"writes":{"detective.room":"1F-Shaft-Monitor"},"observes":["detective.room"],"route_rooms":["R05","1F-Shaft-Monitor"],"not_before_game_minutes":535},
        {"id":"detective.inspect_wind","label":"读取压差、风窗时段与四院接驳登记图","kind":"inspect","at":"1F-Shaft-Monitor","minutes":3,"priority":35,"once":true,"focus":"monitor.gauge","interaction_slot":"monitor.gauge","when":{"detective.phys.asleep":false,"island_environment.phys.wind_window":true},"observes":["monitor.doc.wind_limits","monitor.phys.pressure_clear","academies.doc.route"]},
        {"id":"detective.to_granary","label":"前往B1主粮仓","kind":"walk","at":"1F-Shaft-Monitor","minutes":3,"priority":32,"once":true,"focus":"detective","when":{"detective.phys.asleep":false,"event:detective.inspect_wind.done":true},"writes":{"detective.room":"U01-granary"},"observes":["detective.room"],"route_rooms":["1F-Shaft-Monitor","U01-granary"]},
        {"id":"detective.inspect_granary","label":"核对门槛、锁针与复位绞盘的相互位置","kind":"inspect","at":"U01-granary","minutes":5,"priority":35,"once":true,"focus":"granary.door","interaction_slot":"granary.door","when":{"detective.phys.asleep":false,"granary.lock.open":true},"observes":["granary.trace.sill_level","granary.trace.winch_teeth","granary.trace.lock_pin","granary.phys.structure_braced","granary.lock.picked"]},
        {"id":"detective.read_inventory","label":"按封签点验粮药清册","kind":"read","at":"U01-granary","minutes":4,"priority":35,"once":true,"focus":"granary.ledger","interaction_slot":"granary.ledger","when":{"detective.phys.asleep":false,"event:detective.inspect_granary.done":true},"observes":["granary.doc.inventory","supply.doc.day2_verified"],"requires":{"supply.doc.day2_verified":true}},
        {"id":"detective.to_dining","label":"前往一楼大食堂","kind":"walk","at":"U01-granary","minutes":3,"priority":32,"once":true,"focus":"detective","when":{"detective.phys.asleep":false,"event:detective.read_inventory.done":true},"writes":{"detective.room":"F03"},"observes":["detective.room"],"route_rooms":["U01-granary","F03"]},
        {"id":"detective.read_ration_terms","label":"逐项比较在册份额与热厨领用记录","kind":"read","at":"F03","minutes":4,"priority":35,"once":true,"focus":"ration.ledger","interaction_slot":"ration.ledger","when":{"detective.phys.asleep":false,"ration.policy.disputed":true},"observes":["ration.doc.portions","ration.doc.cooking_loss"]},
        {"id":"detective.deduce_ration","label":"脑内推演：三人开仓与等额热餐可以同时成立","kind":"deduce","at":"F03","minutes":3,"priority":45,"once":true,"focus":"ration.ledger","interaction_slot":"ration.ledger","when":{"detective.phys.asleep":false,"granary.phys.structure_braced":true,"granary.lock.picked":true,"ration.doc.portions":"十六名学员各有同额份额；卧床与值班者可由本人授权代领","ration.doc.cooking_loss":"把定额面粉统一煮成热食不会增加名额；灶火可顺带烧水"},"deduction":{"title":"三人开仓与等额热餐可以同时成立","evidence":[{"id":"e1","when":{"granary.phys.structure_braced":true},"label":"granary.phys.structure_braced"},{"id":"e2","when":{"granary.lock.picked":true},"label":"granary.lock.picked"},{"id":"e3","when":{"ration.doc.portions":"十六名学员各有同额份额；卧床与值班者可由本人授权代领"},"label":"十六人的等额份额"},{"id":"e4","when":{"ration.doc.cooking_loss":"把定额面粉统一煮成热食不会增加名额；灶火可顺带烧水"},"label":"集中烹煮与份额守恒"}],"rules":[{"id":"combine_deduce_ration","all":["e1","e2","e3","e4"],"then":"deduce_ration_supported","label":"三人开仓与等额热餐可以同时成立"}],"conclusion":"deduce_ration_supported","learns":{"detective.infer.dual_ration":true,"detective.infer.granary_cooperation":true},"qualification":"这只说明在册等额份额与共同热餐可以并行；集中烹煮不扩大领取人数，也不把尚未清点的库存算入共同物资。"},"tags":["推演","专注"]},
        {"id":"detective.persuade_ward","label":"向沃德提议保留签收定额、由热厨集中烹煮","kind":"talk","at":"F03","minutes":2,"priority":43,"once":true,"focus":"ward","interaction_slot":"ward","when":{"detective.phys.asleep":false,"detective.infer.dual_ration":true,"detective.infer.granary_cooperation":true},"requires":{"ward.room":"F03"},"suggestion":{"target":"ward","evidence":["detective.infer.dual_ration","detective.infer.granary_cooperation"],"appeal":{"duty":0.7,"fairness":0.7},"cost":0.2,"risk":0.05,"result":"ration.doc.ward_accepted"},"tags":["协作","求证"],"writes":{"ration.doc.ward_signed":true},"observes":["ration.doc.ward_signed"],"completion_lines":[{"when":{"op":"equals","ref":{"type":"ref","object":"ration","facet":"doc","field":"ward_accepted"},"value":true},"text":"沃德：份额不改，锅可以共用。我的签字只管该管的事——你也得替我把授权写全。"}]},
        {"id":"detective.persuade_shen","label":"请沈鼎按签收份额供餐，并保留伤员代领","kind":"talk","at":"F03","minutes":2,"priority":43,"once":true,"focus":"shen","interaction_slot":"shen","when":{"detective.phys.asleep":false,"detective.infer.dual_ration":true,"ration.doc.ward_accepted":true},"requires":{"shen.room":"F03"},"suggestion":{"target":"shen","evidence":["detective.infer.dual_ration"],"appeal":{"care":0.8,"solidarity":0.5},"cost":0.2,"risk":0.05,"result":"ration.doc.shen_accepted"},"tags":["协作","求证"],"writes":{"ration.policy.mediated":true},"observes":["ration.policy.mediated"],"tell":[{"actor":"ward","room":"F03","fields":[],"results":["ration.policy.mediated"]}],"completion_lines":[{"when":{"op":"equals","ref":{"type":"ref","object":"ration","facet":"doc","field":"shen_accepted"},"value":true},"text":"沈鼎：好，十六个名字我一一照着煮。代领记清楚，别让等签字的人把汤等凉了。"}]},
        {"id":"detective.secure_probes","label":"建议雀儿把探针封入本人保管的工具卷","kind":"talk","at":"F03","minutes":2,"priority":20,"once":true,"focus":"quer","interaction_slot":"quer","when":{"detective.phys.asleep":false,"detective.infer.granary_cooperation":true,"quer.doc.custody_concern":true,"probes.trace.custody_risk":"开仓后两支细针沾有锁芯油，工具卷束带磨松；若把卷摊在共用桌上，下一位拿取者和物主容易说不清交接范围。"},"requires":{"quer.room":"F03","probes.phys.owner":"quer"},"suggestion":{"target":"quer","evidence":["detective.infer.granary_cooperation","probes.trace.custody_risk"],"appeal":{"autonomy":0.7,"craft":0.5},"cost":0.2,"risk":0.05,"result":"quer.doc.secure_tools_accepted"},"tags":["协作","求证"],"writes":{"probes.phys.secured":true},"observes":["probes.phys.secured"],"tell":[{"actor":"quer","fields":[],"results":["probes.phys.secured"],"room":"F03"}],"public_completion_text":"侦探：束带已经松了，先把数点清，封签仍由你自己保管。别人需要用，请来问你；保管不该变成替你作主。"},
        {"id":"detective.seal_medical_records","label":"建议维罗妮卡把验药记录逐页编号封存","kind":"talk","at":"F03","minutes":2,"priority":43,"once":true,"focus":"veronica","interaction_slot":"veronica","when":{"detective.phys.asleep":false,"detective.infer.dual_ration":true,"veronica.doc.custody_concern":true,"medicine.doc.page_custody_risk":"从白塔带回的器具清单有逐件编号，个人验药卷仍只有封面题名；允许整理封面不等于允许移走原页。"},"requires":{"veronica.room":"F03","medicine.phys.seal_registered":false},"suggestion":{"target":"veronica","evidence":["detective.infer.dual_ration","medicine.doc.page_custody_risk"],"appeal":{"reason":0.7,"autonomy":0.6},"cost":0.2,"risk":0.05,"result":"veronica.doc.seal_records_accepted"},"tags":["协作","求证"],"writes":{"medicine.phys.seal_registered":true},"observes":["medicine.phys.seal_registered"],"tell":[{"actor":"veronica","fields":[],"results":["medicine.phys.seal_registered"],"room":"F03"}],"public_completion_text":"侦探：按你刚才划的范围，把页号、断口和许可写在骑缝签上。整理封面的人看得见，带走原页的人也再不能说范围没写明。"},
        {"id":"detective.to_academy_dispatch","label":"午后前往中翼，按登记图开展四院初探","kind":"walk","at":"F03","minutes":3,"priority":32,"once":false,"focus":"F03-door","when":{"detective.phys.asleep":false,"ration.policy.mediated":true,"academies.doc.route":"四院初探登记图：文契W-102纸墨分析与白塔B-102配药室由主楼一层公共横路接入；铁工F-104备件室经二层北横路门前接道进入，星仪S-102精密仪器室由二层星仪接驳内廊进入。四院风窗09:00至17:00，16:30停止出发、16:45停止新作业；已在院内者始终可沿原接驳廊回楼。完成巡检者回二楼中翼签名登记，登记只报告可用设施与限制，不授权拆封院藏或增领物资。"},"writes":{"detective.room":"2F-cross-M"},"observes":["detective.room"],"route_rooms":["F03","2F-cross-M"],"unknown":["detective.infer.academy_resource_limits"],"not_before_game_minutes":750},
