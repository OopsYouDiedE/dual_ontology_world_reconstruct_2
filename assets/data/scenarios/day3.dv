        {
          "id": "detective.deduce_ration_forgery",
          "label": "脑内推演：旧签名只认证空箱回收，收件时刻无法认证新授权",
          "kind": "deduce",
          "at": "R10",
          "minutes": 3,
          "priority": 45,
          "once": true,
          "focus": "ruan.board",
          "interaction_slot": "ruan.board",
          "when": {
            "detective.phys.asleep": false,
            "receipt.doc.old_text": "归还空箱六只；此签字只确认收回空箱，不授权新增领取口粮",
            "receipt.doc.new_text": "据此可再领六份共同口粮；旁有旧签名，正文上存在新刮改",
            "receipt.trace.scraping": "签名墨层已干，正文纸纤维被刮薄，新墨覆盖刮痕",
            "demon.doc.cup_witness": "配餐铃第一响期间，沈鼎当面看见代管者在F03双手递杯",
            "receipt.doc.receiving_place": "F04收发台在配餐铃第一响期间收到票据；这是收件时刻"
          },
          "deduction": {
            "title": "旧签名只认证空箱回收，收件时刻无法认证新授权",
            "evidence": [
              {
                "id": "e1",
                "when": {
                  "receipt.doc.old_text": "归还空箱六只；此签字只确认收回空箱，不授权新增领取口粮"
                },
                "label": "旧空箱回收台账"
              },
              {
                "id": "e2",
                "when": {
                  "receipt.doc.new_text": "据此可再领六份共同口粮；旁有旧签名，正文上存在新刮改"
                },
                "label": "新增领取六份口粮的刮改正文"
              },
              {
                "id": "e3",
                "when": {
                  "receipt.trace.scraping": "签名墨层已干，正文纸纤维被刮薄，新墨覆盖刮痕"
                },
                "label": "纸面刮痕与新旧墨层"
              },
              {
                "id": "e4",
                "when": {
                  "demon.doc.cup_witness": "配餐铃第一响期间，沈鼎当面看见代管者在F03双手递杯"
                },
                "label": "F03递杯的实际证言"
              },
              {
                "id": "e5",
                "when": {
                  "receipt.doc.receiving_place": "F04收发台在配餐铃第一响期间收到票据；这是收件时刻"
                },
                "label": "F04的收件时间与地点"
              }
            ],
            "rules": [
              {
                "id": "combine_deduce_ration_forgery",
                "all": [
                  "e1",
                  "e2",
                  "e3",
                  "e4",
                  "e5"
                ],
                "then": "deduce_ration_forgery_supported",
                "label": "旧签名只认证空箱回收，收件时刻无法认证新授权"
              }
            ],
            "conclusion": "deduce_ration_forgery_supported",
            "learns": {
              "detective.infer.receipt_authorization_invalid": true,
              "detective.infer.signature_time_distinct": true
            },
            "qualification": "旧签名只认证原用途，收件时刻也不是落笔时刻；证据支持新正文越权与刮改，不把代管者的真实签名直接等同于同意新领用。"
          },
          "tags": [
            "推演",
            "专注"
          ]
        },
