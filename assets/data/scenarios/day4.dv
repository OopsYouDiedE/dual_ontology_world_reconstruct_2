        {"id":"detective.inspect_backflow","label":"观察旁路回流与紧闭门扇，确定污染如何越界","kind":"inspect","at":"B2-control","minutes":0.5,"priority":35,"once":true,"focus":"B1.interlock","interaction_slot":"B1.interlock","when":{"detective.phys.asleep":false,"backflow.phys.active":true},"observes":["B2.trace.leak_path"]},
        {"id":"detective.deduce_airlock","label":"脑内推演：把闭合边界与污染旁路分别建模，限定短时封隔","kind":"deduce","at":"B2-control","minutes":2,"priority":45,"once":true,"focus":"detective.casebook","interaction_slot":"detective.casebook","when":{"detective.phys.asleep":false,"B2.doc.topology":"B1服务廊沿检修坡道下行至B2控制室；隔墙通口接低位阀廊，不能把控制室与阀廊视为同一空间","B2.trace.closed_boundary":"控制室隔离门已经闭合，门框与整圈阀道共同限定空气越界的边界","B2.trace.leak_path":"门虽闭合，松动联锁阀的旁路仍会让污染气体从低位阀廊流入控制室","B2.doc.temporary_rule":"言灵可以约束已理解的局部通行规则；耗尽专注后不能维持，机械止挡仍需实际安装","contract.doc.seven":"第七条只保护尚不知道当前具体致命危险的在册者；保护义务可通过把人移到安全处履行"},"deduction":{"title":"把闭合边界与污染旁路分别建模，限定短时封隔","evidence":[{"id":"e1","when":{"B2.doc.topology":"B1服务廊沿检修坡道下行至B2控制室；隔墙通口接低位阀廊，不能把控制室与阀廊视为同一空间"},"label":"坡道、控制室与隔墙通口的空间关系"},{"id":"e2","when":{"B2.trace.closed_boundary":"控制室隔离门已经闭合，门框与整圈阀道共同限定空气越界的边界"},"label":"闭合门扇与完整边界"},{"id":"e3","when":{"B2.trace.leak_path":"门虽闭合，松动联锁阀的旁路仍会让污染气体从低位阀廊流入控制室"},"label":"绕过门扇的污染旁路"},{"id":"e4","when":{"B2.doc.temporary_rule":"言灵可以约束已理解的局部通行规则；耗尽专注后不能维持，机械止挡仍需实际安装"},"label":"局部规则的时效与代价"},{"id":"e5","when":{"contract.doc.seven":"第七条只保护尚不知道当前具体致命危险的在册者；保护义务可通过把人移到安全处履行"},"label":"第七条的具体知情与移离义务"}],"rules":[{"id":"combine_deduce_airlock","all":["e1","e2","e3","e4","e5"],"then":"deduce_airlock_supported","label":"把闭合边界与污染旁路分别建模，限定短时封隔"}],"conclusion":"deduce_airlock_supported","learns":{"detective.infer.safe_airlock":true,"detective.infer.seventh_clause_limits":true},"qualification":"短时言灵只限制已经核对的局部通行边界，不能治疗暴露者或替代整夜的机械止挡；第七条的保护也可以通过把人移到安全处履行。"},"tags":["推演","专注"]},
        {"id":"detective.seal_airlock","label":"言灵：「闭合之门，不纳污息」","kind":"incant","at":"B2-control","minutes":0.5,"priority":62,"once":true,"focus":"B1.interlock","interaction_slot":"B1.interlock","when":{"detective.phys.asleep":false,"detective.infer.safe_airlock":true,"backflow.phys.active":true},"incantation":{"formula":"闭合之门，不纳污息","requires":{"detective.infer.safe_airlock":true,"detective.infer.seventh_clause_limits":true},"resource":"detective.phys.resolve","cost":12,"backlash":{"field":"detective.phys.corruption","amount":3},"rule":{"field":"airlock.lock.sealed","value":true,"duration_minutes":45},"witnesses":["huo","quer","margaret"]},"tags":["言灵","防卫"],"public_completion_text":"侦探：闭合之门，不纳污息。\n示流丝在门边颤了一下，指尖的刺痛沿手背攀上来。侦探没有松开钟表：只有四十五分钟，门仍得靠你们的手锁住。"},
