        {"id":"detective.to_control","label":"前往B2低位控制室","kind":"walk","at":"B1-hazard","minutes":3,"priority":32,"once":true,"focus":"detective","when":{"detective.phys.asleep":false,"event:detective.read_seventh_clause.done":true},"writes":{"detective.room":"B2-control"},"observes":["detective.room"],"route_rooms":["B1-hazard","B2-control"]},
        {"id":"detective.inspect_topology","label":"顺着阀路图核对控制室、隔墙通口与低位阀廊","kind":"inspect","at":"B2-control","minutes":5,"priority":35,"once":true,"focus":"B2.panel","interaction_slot":"B2.panel","when":{"detective.phys.asleep":false,"event:detective.to_control.done":true},"observes":["B2.doc.topology","B2.trace.closed_boundary","B2.doc.temporary_rule","night_day4.doc.safe_room_available","night_day4.doc.plan_chosen"]},
