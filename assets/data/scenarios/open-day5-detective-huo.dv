        {"id":"detective.deduce_coupling","label":"脑内推演：时间差、拉门抽吸与泛音门户共同解释苏泠的特殊耦合","kind":"deduce","at":"1F-Shaft-Monitor","minutes":5,"priority":3,"once":true,"focus":"shaft_niche_1F","interaction_slot":"shaft_niche_1F","when":{"detective.phys.asleep":false,"monitor.doc.time_separation":"分时机械记录：23:33卢西安返回甲区；23:33:30源质涌上二楼；23:34乙区门扇突开","monitor.trace.pressure_impulse":"乙区内开门瞬间有向内压差尖峰；其后门扇回弹，湿布与反扣先后压低通量","su.trace.harmonic_marker":"苏泠反复辨出封闭微晶样本的同一泛音；空管与常规对照不出现同样反应","su.trace.closed_sample_response":"三轮低幅音阶中的反应峰保持在同一泛音，遮去样本标签后结果仍一致","B_case.infer.sequence_supported":true,"island_case.infer.history_correlated":true},"deduction":{"title":"时间差、拉门抽吸与泛音门户共同解释苏泠的特殊耦合","evidence":[{"id":"e1","when":{"monitor.doc.time_separation":"分时机械记录：23:33卢西安返回甲区；23:33:30源质涌上二楼；23:34乙区门扇突开"},"label":"返回、喷发与开门的三段时间"},{"id":"e2","when":{"monitor.trace.pressure_impulse":"乙区内开门瞬间有向内压差尖峰；其后门扇回弹，湿布与反扣先后压低通量"},"label":"乙区门内方向的压差尖峰"},{"id":"e3","when":{"su.trace.harmonic_marker":"苏泠反复辨出封闭微晶样本的同一泛音；空管与常规对照不出现同样反应"},"label":"苏泠与封闭微晶样本的重复泛音反应"},{"id":"e4","when":{"su.trace.closed_sample_response":"三轮低幅音阶中的反应峰保持在同一泛音，遮去样本标签后结果仍一致"},"label":"遮蔽标签后的重复对照"},{"id":"e5","when":{"B_case.infer.sequence_supported":true},"label":"B_case.infer.sequence_supported"},{"id":"e6","when":{"island_case.infer.history_correlated":true},"label":"island_case.infer.history_correlated"}],"rules":[{"id":"combine_deduce_coupling","all":["e1","e2","e3","e4","e5","e6"],"then":"deduce_coupling_supported","label":"时间差、拉门抽吸与泛音门户共同解释苏泠的特殊耦合"}],"conclusion":"deduce_coupling_supported","learns":{"detective.infer.su_coupling_explained":true},"qualification":"这一组合支持苏泠特殊耦合的解释；单项声学反应不证明他人绝无微量暴露，代管者自述仍单列来源。"},"tags":["日常生活","自发查验"]},
