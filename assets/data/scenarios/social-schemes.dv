        {"id":"ruan.scheme.test_design","label":"把登记办法中的可检验差异排成两列","kind":"interact","at":"F03","focus":"ruan","interaction_slot":"ruan","once":true,"minutes":4,"priority":0,"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"ruan","facet":"doc","field":"self_directed_today"},"value":true},{"op":"equals","ref":{"type":"ref","object":"ruan","facet":"phys","field":"asleep"},"value":false},{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"schemes","facet":"doc","field":"ward_register"},"value":true},{"op":"not","item":{"op":"all","items":[{"op":"not","item":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"schemes","facet":"doc","field":"quer_terms"},"value":true}]}},{"op":"not","item":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"schemes","facet":"doc","field":"ward_unilateral"},"value":true}]}}]}}]}]},"writes":{"ruan.doc.scheme_test_design":true},"observes":["ruan.doc.scheme_test_design"],"tags":["自主安排","职业经验"],"need_above":{"energy":24},"planning_model":{"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"ruan","facet":"doc","field":"self_directed_today"},"value":true},{"op":"known","ref":{"type":"ref","object":"ruan","facet":"doc","field":"professional_memory"}}]},"effects":{"ruan.doc.scheme_test_design":true},"cost":1.3333333333333333,"uncertainty_cost":0},"completion_text":"争的是谁替谁说话。我可以借他们的簿做一盘公开试应手：先写判准，再看谁肯接受自己也被判。"},
        {"id":"ruan.scheme.ruan_test","label":"提出先写判准、再换一条无害记录的公开试探","kind":"interact","at":"F03","focus":"F03-table","interaction_slot":"F03-table","once":true,"minutes":3,"priority":0,"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"ruan","facet":"doc","field":"self_directed_today"},"value":true},{"op":"equals","ref":{"type":"ref","object":"ruan","facet":"phys","field":"asleep"},"value":false},{"op":"equals","ref":{"type":"ref","object":"ruan","facet":"doc","field":"scheme_test_design"},"value":true}]},"writes":{"schemes.doc.ruan_test":true,"schemes.doc.ruan_test_text":"阮清月：借你们这本簿试一手。两份相同的空白借条，一份不署名，一份写明“可撤回”。先写下你会怎样处理，再看落款；不借真工具，不把人逼到险处。原判准已经写好，先放在桌边。","schemes.phys.criteria_holder":"F03-table"},"observes":["schemes.doc.ruan_test","schemes.doc.ruan_test_text","schemes.phys.criteria_holder"],"tags":["自主安排","职业经验"],"need_above":{"energy":24},"planning_model":{"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"ruan","facet":"doc","field":"self_directed_today"},"value":true},{"op":"known","ref":{"type":"ref","object":"ruan","facet":"doc","field":"professional_memory"}}]},"effects":{"schemes.doc.ruan_test":true,"schemes.phys.criteria_holder":"F03-table"},"cost":1.0,"uncertainty_cost":0},"public_completion_text":"阮清月：借你们这本簿试一手。两份相同的空白借条，一份不署名，一份写明“可撤回”。先写下你会怎样处理，再看落款；不借真工具，不把人逼到险处。原判准已经写好，先放在桌边。","tell":[{"actor":"gu","room":"F03","results":["schemes.doc.ruan_test","schemes.doc.ruan_test_text"]},{"actor":"quer","room":"F03","results":["schemes.doc.ruan_test","schemes.doc.ruan_test_text"]},{"actor":"ward","room":"F03","results":["schemes.doc.ruan_test","schemes.doc.ruan_test_text"]}]},
        {"id":"ruan.scheme.ask_test_witness","label":"请顾平章保存试探前已经写定的判准","kind":"talk","at":"F03","focus":"gu","interaction_slot":"gu","once":true,"minutes":2,"priority":0,"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"ruan","facet":"doc","field":"self_directed_today"},"value":true},{"op":"equals","ref":{"type":"ref","object":"ruan","facet":"phys","field":"asleep"},"value":false},{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"schemes","facet":"doc","field":"ruan_test"},"value":true},{"op":"equals","ref":{"type":"ref","object":"gu","facet":"state","field":"room"},"value":"F03"}]}]},"writes":{},"observes":[],"tags":["自主安排","职业经验"],"need_above":{"energy":24},"planning_model":{"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"ruan","facet":"doc","field":"self_directed_today"},"value":true},{"op":"known","ref":{"type":"ref","object":"ruan","facet":"doc","field":"professional_memory"}}]},"effects":{"gu.doc.scheme_test_witness_consent":true},"cost":0.6666666666666666,"uncertainty_cost":4},"public_completion_text":"阮清月：请你收着我先写的那张纸。若我看了应手才改判准，你就把两张并排给人看。","unknown":["gu.doc.scheme_test_witness_consent"],"requires":{"gu.room":"F03"},"suggestion":{"target":"gu","result":"gu.doc.scheme_test_witness_consent","evidence":["schemes.doc.ruan_test","schemes.doc.quer_terms"],"appeal":{"reason":0.6,"honesty":0.6},"cost":0.25,"risk":0.5}},
        {"id":"ruan.scheme.ruan_test_record","label":"把有限试探的判准和未回答项一并归档","kind":"interact","at":"F03","focus":"F03-table","interaction_slot":"F03-table","once":true,"minutes":3,"priority":0,"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"ruan","facet":"doc","field":"self_directed_today"},"value":true},{"op":"equals","ref":{"type":"ref","object":"ruan","facet":"phys","field":"asleep"},"value":false},{"op":"equals","ref":{"type":"ref","object":"gu","facet":"doc","field":"scheme_test_witness_consent"},"value":true},{"op":"equals","ref":{"type":"ref","object":"schemes","facet":"doc","field":"gu_criteria_received"},"value":true}]},"writes":{"schemes.doc.ruan_test_record":true,"schemes.doc.ruan_test_record_text":"阮清月：顾先生收了原判准。现在只比较这两张纸，不把任何人的选择推成一生的品性；没来答的人，留白。"},"observes":["schemes.doc.ruan_test_record","schemes.doc.ruan_test_record_text"],"tags":["自主安排","职业经验"],"need_above":{"energy":24},"planning_model":{"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"ruan","facet":"doc","field":"self_directed_today"},"value":true},{"op":"known","ref":{"type":"ref","object":"ruan","facet":"doc","field":"professional_memory"}}]},"effects":{"schemes.doc.ruan_test_record":true},"cost":1.0,"uncertainty_cost":0},"public_completion_text":"阮清月：顾先生收了原判准。现在只比较这两张纸，不把任何人的选择推成一生的品性；没来答的人，留白。","tell":[{"actor":"gu","room":"F03","results":["schemes.doc.ruan_test_record","schemes.doc.ruan_test_record_text"]},{"actor":"quer","room":"F03","results":["schemes.doc.ruan_test_record","schemes.doc.ruan_test_record_text"]},{"actor":"ward","room":"F03","results":["schemes.doc.ruan_test_record","schemes.doc.ruan_test_record_text"]}]},
        {"id":"ruan.scheme.ruan_self_test","label":"见证被拒后改用自己的两份旧稿作反例","kind":"interact","at":"F03","focus":"F03-table","interaction_slot":"F03-table","once":true,"minutes":3,"priority":0,"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"ruan","facet":"doc","field":"self_directed_today"},"value":true},{"op":"equals","ref":{"type":"ref","object":"ruan","facet":"phys","field":"asleep"},"value":false},{"op":"equals","ref":{"type":"ref","object":"gu","facet":"doc","field":"scheme_test_witness_consent"},"value":false}]},"writes":{"schemes.doc.ruan_self_test":true,"schemes.doc.ruan_self_test_text":"阮清月：没有见证人，我就不拿别人的名字试。用我自己的两份旧稿：一份先下结论，一份先列条件。至少先查清我会在哪一步偷换判准。"},"observes":["schemes.doc.ruan_self_test","schemes.doc.ruan_self_test_text"],"tags":["自主安排","职业经验"],"need_above":{"energy":24},"planning_model":{"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"ruan","facet":"doc","field":"self_directed_today"},"value":true},{"op":"known","ref":{"type":"ref","object":"ruan","facet":"doc","field":"professional_memory"}}]},"effects":{"schemes.doc.ruan_self_test":true},"cost":1.0,"uncertainty_cost":0},"public_completion_text":"阮清月：没有见证人，我就不拿别人的名字试。用我自己的两份旧稿：一份先下结论，一份先列条件。至少先查清我会在哪一步偷换判准。","tell":[{"actor":"gu","room":"F03","results":["schemes.doc.ruan_self_test","schemes.doc.ruan_self_test_text"]},{"actor":"quer","room":"F03","results":["schemes.doc.ruan_self_test","schemes.doc.ruan_self_test_text"]},{"actor":"ward","room":"F03","results":["schemes.doc.ruan_self_test","schemes.doc.ruan_self_test_text"]}]}
