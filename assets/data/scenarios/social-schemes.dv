    {
      "id": "lucian",
      "knows": {"lucian.doc.scheme_signature_draft":false},
      "actions": [
        {"id":"lucian.scheme.signature_draft","label":"想好自己愿承担的名字与责任","kind":"interact","at":"F03","focus":"lucian","interaction_slot":"lucian","once":true,"minutes":4,"priority":0,"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"lucian","facet":"doc","field":"self_directed_today"},"value":true},{"op":"equals","ref":{"type":"ref","object":"lucian","facet":"phys","field":"asleep"},"value":false},{"op":"equals","ref":{"type":"ref","object":"schemes","facet":"doc","field":"ward_register"},"value":true}]},"writes":{"lucian.doc.scheme_signature_draft":true},"observes":["lucian.doc.scheme_signature_draft"],"tags":["自主安排","职业经验"],"need_above":{"energy":24},"planning_model":{"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"lucian","facet":"doc","field":"self_directed_today"},"value":true},{"op":"known","ref":{"type":"ref","object":"lucian","facet":"doc","field":"professional_memory"}}]},"effects":{"lucian.doc.scheme_signature_draft":true},"cost":1.3333333333333333,"uncertainty_cost":0},"completion_text":"若我的名字终于能替谁挡一次追问，人们或许不只记得那首冒名的诗。但我还没问她愿不愿意。"},
        {"id":"lucian.scheme.lucian_patron","label":"提出由自己署名承担雀儿的借用争议","kind":"interact","at":"F03","focus":"F03-table","interaction_slot":"F03-table","once":true,"minutes":3,"priority":0,"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"lucian","facet":"doc","field":"self_directed_today"},"value":true},{"op":"equals","ref":{"type":"ref","object":"lucian","facet":"phys","field":"asleep"},"value":false},{"op":"equals","ref":{"type":"ref","object":"lucian","facet":"doc","field":"scheme_signature_draft"},"value":true}]},"writes":{"schemes.doc.lucian_patron":true,"schemes.doc.lucian_patron_text":"卢西安：先把我的名字写上。若有人追究雀儿借过的东西，让他来找我。我总不能只在吟诗时声音洪亮。"},"observes":["schemes.doc.lucian_patron","schemes.doc.lucian_patron_text"],"tags":["自主安排","职业经验"],"need_above":{"energy":24},"planning_model":{"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"lucian","facet":"doc","field":"self_directed_today"},"value":true},{"op":"known","ref":{"type":"ref","object":"lucian","facet":"doc","field":"professional_memory"}}]},"effects":{"schemes.doc.lucian_patron":true},"cost":1.0,"uncertainty_cost":0},"public_completion_text":"卢西安：先把我的名字写上。若有人追究雀儿借过的东西，让他来找我。我总不能只在吟诗时声音洪亮。","tell":[{"actor":"quer","room":"F03","results":["schemes.doc.lucian_patron","schemes.doc.lucian_patron_text"]},{"actor":"ward","room":"F03","results":["schemes.doc.lucian_patron","schemes.doc.lucian_patron_text"]},{"actor":"gu","room":"F03","results":["schemes.doc.lucian_patron","schemes.doc.lucian_patron_text"]}]},
        {"id":"lucian.scheme.ask_patron","label":"问雀儿是否接受由自己承担她的借用争议","kind":"talk","at":"F03","focus":"quer","interaction_slot":"quer","once":true,"minutes":2,"priority":0,"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"lucian","facet":"doc","field":"self_directed_today"},"value":true},{"op":"equals","ref":{"type":"ref","object":"lucian","facet":"phys","field":"asleep"},"value":false},{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"schemes","facet":"doc","field":"lucian_patron"},"value":true},{"op":"equals","ref":{"type":"ref","object":"quer","facet":"state","field":"room"},"value":"F03"}]}]},"writes":{},"observes":[],"tags":["自主安排","职业经验"],"need_above":{"energy":24},"planning_model":{"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"lucian","facet":"doc","field":"self_directed_today"},"value":true},{"op":"known","ref":{"type":"ref","object":"lucian","facet":"doc","field":"professional_memory"}}]},"effects":{"quer.doc.scheme_hero_consent":true},"cost":0.6666666666666666,"uncertainty_cost":4},"public_completion_text":"卢西安：这只是我的提议。你若不愿意，我的名字不能挡住你的回答。","unknown":["quer.doc.scheme_hero_consent"],"requires":{"quer.room":"F03"},"suggestion":{"target":"quer","result":"quer.doc.scheme_hero_consent","evidence":["schemes.doc.lucian_patron"],"appeal":{"safety":0.5,"autonomy":-0.5,"fairness":0.1},"cost":0.25,"risk":0.65}},
        {"id":"lucian.scheme.lucian_limited_offer","label":"把保护承诺改成仅对亲见之事署名","kind":"interact","at":"F03","focus":"F03-table","interaction_slot":"F03-table","once":true,"minutes":3,"priority":0,"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"lucian","facet":"doc","field":"self_directed_today"},"value":true},{"op":"equals","ref":{"type":"ref","object":"lucian","facet":"phys","field":"asleep"},"value":false},{"op":"equals","ref":{"type":"ref","object":"quer","facet":"doc","field":"scheme_hero_consent"},"value":false}]},"writes":{"schemes.doc.lucian_limited_offer":true,"schemes.doc.lucian_limited_offer_text":"卢西安：好，我把“替你”划掉。我只写我亲眼看见的，也允许你当着我的面说我记错了。这样，我的名字还算有用么？"},"observes":["schemes.doc.lucian_limited_offer","schemes.doc.lucian_limited_offer_text"],"tags":["自主安排","职业经验"],"need_above":{"energy":24},"planning_model":{"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"lucian","facet":"doc","field":"self_directed_today"},"value":true},{"op":"known","ref":{"type":"ref","object":"lucian","facet":"doc","field":"professional_memory"}}]},"effects":{"schemes.doc.lucian_limited_offer":true},"cost":1.0,"uncertainty_cost":0},"public_completion_text":"卢西安：好，我把“替你”划掉。我只写我亲眼看见的，也允许你当着我的面说我记错了。这样，我的名字还算有用么？","tell":[{"actor":"quer","room":"F03","results":["schemes.doc.lucian_limited_offer","schemes.doc.lucian_limited_offer_text"]},{"actor":"ward","room":"F03","results":["schemes.doc.lucian_limited_offer","schemes.doc.lucian_limited_offer_text"]},{"actor":"gu","room":"F03","results":["schemes.doc.lucian_limited_offer","schemes.doc.lucian_limited_offer_text"]}]},
        {"id":"lucian.scheme.ask_witness","label":"请求只以本人名义见证可撤回的工具交接","kind":"talk","at":"F03","focus":"quer","interaction_slot":"quer","once":true,"minutes":2,"priority":0,"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"lucian","facet":"doc","field":"self_directed_today"},"value":true},{"op":"equals","ref":{"type":"ref","object":"lucian","facet":"phys","field":"asleep"},"value":false},{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"schemes","facet":"doc","field":"lucian_limited_offer"},"value":true},{"op":"equals","ref":{"type":"ref","object":"schemes","facet":"doc","field":"quer_terms"},"value":true},{"op":"equals","ref":{"type":"ref","object":"quer","facet":"state","field":"room"},"value":"F03"}]}]},"writes":{},"observes":[],"tags":["自主安排","职业经验"],"need_above":{"energy":24},"planning_model":{"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"lucian","facet":"doc","field":"self_directed_today"},"value":true},{"op":"known","ref":{"type":"ref","object":"lucian","facet":"doc","field":"professional_memory"}}]},"effects":{"quer.doc.scheme_lucian_witness_consent":true},"cost":0.6666666666666666,"uncertainty_cost":4},"public_completion_text":"卢西安：你保管原件。我站在一旁，见到什么写什么，绝不替你签。","unknown":["quer.doc.scheme_lucian_witness_consent"],"requires":{"quer.room":"F03"},"suggestion":{"target":"quer","result":"quer.doc.scheme_lucian_witness_consent","evidence":["schemes.doc.lucian_limited_offer","schemes.doc.quer_terms"],"appeal":{"autonomy":0.7,"fairness":0.7,"craft":0.4},"cost":0.1,"risk":0.15}},
        {"id":"lucian.scheme.lucian_signed_witness","label":"在获得许可后只签自己的见闻","kind":"interact","at":"F03","focus":"F03-table","interaction_slot":"F03-table","once":true,"minutes":3,"priority":0,"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"lucian","facet":"doc","field":"self_directed_today"},"value":true},{"op":"equals","ref":{"type":"ref","object":"lucian","facet":"phys","field":"asleep"},"value":false},{"op":"equals","ref":{"type":"ref","object":"quer","facet":"doc","field":"scheme_lucian_witness_consent"},"value":true}]},"writes":{"schemes.doc.lucian_signed_witness":true,"schemes.doc.lucian_signed_witness_text":"卢西安：这一行是我的见闻，下一行请雀儿自己决定写不写。若我记错，先改我的，不必替我留面子。"},"observes":["schemes.doc.lucian_signed_witness","schemes.doc.lucian_signed_witness_text"],"tags":["自主安排","职业经验"],"need_above":{"energy":24},"planning_model":{"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"lucian","facet":"doc","field":"self_directed_today"},"value":true},{"op":"known","ref":{"type":"ref","object":"lucian","facet":"doc","field":"professional_memory"}}]},"effects":{"schemes.doc.lucian_signed_witness":true},"cost":1.0,"uncertainty_cost":0},"public_completion_text":"卢西安：这一行是我的见闻，下一行请雀儿自己决定写不写。若我记错，先改我的，不必替我留面子。","tell":[{"actor":"quer","room":"F03","results":["schemes.doc.lucian_signed_witness","schemes.doc.lucian_signed_witness_text"]},{"actor":"ward","room":"F03","results":["schemes.doc.lucian_signed_witness","schemes.doc.lucian_signed_witness_text"]},{"actor":"gu","room":"F03","results":["schemes.doc.lucian_signed_witness","schemes.doc.lucian_signed_witness_text"]}]},
        {"id":"lucian.scheme.lucian_no_mandate","label":"被再次拒绝后撤回代言位置","kind":"interact","at":"F03","focus":"F03-table","interaction_slot":"F03-table","once":true,"minutes":3,"priority":0,"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"lucian","facet":"doc","field":"self_directed_today"},"value":true},{"op":"equals","ref":{"type":"ref","object":"lucian","facet":"phys","field":"asleep"},"value":false},{"op":"equals","ref":{"type":"ref","object":"quer","facet":"doc","field":"scheme_lucian_witness_consent"},"value":false}]},"writes":{"schemes.doc.lucian_no_mandate":true,"schemes.doc.lucian_no_mandate_text":"卢西安：她连见证也暂时不要。这回我听懂了。我把自己的话留在这里，人退开；没有下一句替她解释。"},"observes":["schemes.doc.lucian_no_mandate","schemes.doc.lucian_no_mandate_text"],"tags":["自主安排","职业经验"],"need_above":{"energy":24},"planning_model":{"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"lucian","facet":"doc","field":"self_directed_today"},"value":true},{"op":"known","ref":{"type":"ref","object":"lucian","facet":"doc","field":"professional_memory"}}]},"effects":{"schemes.doc.lucian_no_mandate":true},"cost":1.0,"uncertainty_cost":0},"public_completion_text":"卢西安：她连见证也暂时不要。这回我听懂了。我把自己的话留在这里，人退开；没有下一句替她解释。","tell":[{"actor":"quer","room":"F03","results":["schemes.doc.lucian_no_mandate","schemes.doc.lucian_no_mandate_text"]},{"actor":"ward","room":"F03","results":["schemes.doc.lucian_no_mandate","schemes.doc.lucian_no_mandate_text"]},{"actor":"gu","room":"F03","results":["schemes.doc.lucian_no_mandate","schemes.doc.lucian_no_mandate_text"]}]},
        {"id":"lucian.scheme.lucian_named_guarantee","label":"依雀儿本次许可署名担保，不改动她的记录","kind":"interact","at":"F03","focus":"F03-table","interaction_slot":"F03-table","once":true,"minutes":3,"priority":0,"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"lucian","facet":"doc","field":"self_directed_today"},"value":true},{"op":"equals","ref":{"type":"ref","object":"lucian","facet":"phys","field":"asleep"},"value":false},{"op":"equals","ref":{"type":"ref","object":"quer","facet":"doc","field":"scheme_hero_consent"},"value":true}]},"writes":{"schemes.doc.lucian_named_guarantee":true,"schemes.doc.lucian_named_guarantee_text":"卢西安：她同意的是我承担这次借用的争议。记清楚：我签的是自己的责任，她的记录和以后的决定仍归她。"},"observes":["schemes.doc.lucian_named_guarantee","schemes.doc.lucian_named_guarantee_text"],"tags":["自主安排","职业经验"],"need_above":{"energy":24},"planning_model":{"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"lucian","facet":"doc","field":"self_directed_today"},"value":true},{"op":"known","ref":{"type":"ref","object":"lucian","facet":"doc","field":"professional_memory"}}]},"effects":{"schemes.doc.lucian_named_guarantee":true},"cost":1.0,"uncertainty_cost":0},"public_completion_text":"卢西安：她同意的是我承担这次借用的争议。记清楚：我签的是自己的责任，她的记录和以后的决定仍归她。","tell":[{"actor":"quer","room":"F03","results":["schemes.doc.lucian_named_guarantee","schemes.doc.lucian_named_guarantee_text"]},{"actor":"ward","room":"F03","results":["schemes.doc.lucian_named_guarantee","schemes.doc.lucian_named_guarantee_text"]},{"actor":"gu","room":"F03","results":["schemes.doc.lucian_named_guarantee","schemes.doc.lucian_named_guarantee_text"]}]}
