      "opinion": {"modifiers":[{"speaker":"lucian","when":{"schemes.doc.lucian_patron":true},"score":-0.65,"reason":"对方提出以自己的名字承担我的争议；安全的好意仍可能吞掉我的授权"},{"speaker":"lucian","when":{"schemes.doc.lucian_limited_offer":true},"score":0.85,"reason":"已经听见对方划去替我代言、只对本人亲见之事负责的公开修订"}]}
