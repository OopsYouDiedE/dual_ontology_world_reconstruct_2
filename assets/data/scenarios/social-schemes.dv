        {"id":"gu.scheme.gu_source_rules","label":"要求所有记录标明署名、来源与未核部分","kind":"interact","at":"F03","focus":"F03-table","interaction_slot":"F03-table","once":true,"minutes":3,"priority":0,"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"gu","facet":"doc","field":"self_directed_today"},"value":true},{"op":"equals","ref":{"type":"ref","object":"gu","facet":"phys","field":"asleep"},"value":false},{"op":"equals","ref":{"type":"ref","object":"gu","facet":"doc","field":"scheme_source_index"},"value":true}]},"writes":{"schemes.doc.gu_source_rules":true,"schemes.doc.gu_source_rules_text":"顾平章：每一条先写谁说的、在哪里见到的，再写哪些地方没核过。字写进同一本簿，并不能使它们同样可信；我愿作索引，不愿替未核之事盖印。"},"observes":["schemes.doc.gu_source_rules","schemes.doc.gu_source_rules_text"],"tags":["自主安排","职业经验"],"need_above":{"energy":24},"planning_model":{"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"gu","facet":"doc","field":"self_directed_today"},"value":true},{"op":"known","ref":{"type":"ref","object":"gu","facet":"doc","field":"professional_memory"}}]},"effects":{"schemes.doc.gu_source_rules":true},"cost":1.0,"uncertainty_cost":0},"public_completion_text":"顾平章：每一条先写谁说的、在哪里见到的，再写哪些地方没核过。字写进同一本簿，并不能使它们同样可信；我愿作索引，不愿替未核之事盖印。","tell":[{"actor":"ward","room":"F03","results":["schemes.doc.gu_source_rules","schemes.doc.gu_source_rules_text"]},{"actor":"quer","room":"F03","results":["schemes.doc.gu_source_rules","schemes.doc.gu_source_rules_text"]},{"actor":"ruan","room":"F03","results":["schemes.doc.gu_source_rules","schemes.doc.gu_source_rules_text"]}]},
        {"id":"gu.scheme.ask_source_index","label":"请沃德允许在汇总页保留异议与原话","kind":"talk","at":"F03","focus":"ward","interaction_slot":"ward","once":true,"minutes":2,"priority":0,"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"gu","facet":"doc","field":"self_directed_today"},"value":true},{"op":"equals","ref":{"type":"ref","object":"gu","facet":"phys","field":"asleep"},"value":false},{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"schemes","facet":"doc","field":"gu_source_rules"},"value":true},{"op":"equals","ref":{"type":"ref","object":"schemes","facet":"doc","field":"ward_register"},"value":true},{"op":"equals","ref":{"type":"ref","object":"ward","facet":"state","field":"room"},"value":"F03"}]}]},"writes":{},"observes":[],"tags":["自主安排","职业经验"],"need_above":{"energy":24},"planning_model":{"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"gu","facet":"doc","field":"self_directed_today"},"value":true},{"op":"known","ref":{"type":"ref","object":"gu","facet":"doc","field":"professional_memory"}}]},"effects":{"ward.doc.scheme_source_index_consent":true},"cost":0.6666666666666666,"uncertainty_cost":4},"public_completion_text":"顾平章：你的总簿可以更清楚，也得更难替人下结论。原话和反对意见都留在边上，你是否愿意？","unknown":["ward.doc.scheme_source_index_consent"],"requires":{"ward.room":"F03"},"suggestion":{"target":"ward","result":"ward.doc.scheme_source_index_consent","evidence":["schemes.doc.gu_source_rules","schemes.doc.ward_register"],"appeal":{"honesty":0.8,"fairness":0.7,"duty":0.3},"cost":0.35,"risk":0.2}},
        {"id":"gu.scheme.gu_index_accepted","label":"在得到同意后给汇总页加上来源栏","kind":"interact","at":"F03","focus":"F03-table","interaction_slot":"F03-table","once":true,"minutes":3,"priority":0,"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"gu","facet":"doc","field":"self_directed_today"},"value":true},{"op":"equals","ref":{"type":"ref","object":"gu","facet":"phys","field":"asleep"},"value":false},{"op":"equals","ref":{"type":"ref","object":"ward","facet":"doc","field":"scheme_source_index_consent"},"value":true}]},"writes":{"schemes.doc.gu_index_accepted":true,"schemes.doc.gu_index_accepted_text":"顾平章：沃德同意留来源和异议。我只替索引署名，不替每一位发言者担保；读者还须回到那个人面前去问。"},"observes":["schemes.doc.gu_index_accepted","schemes.doc.gu_index_accepted_text"],"tags":["自主安排","职业经验"],"need_above":{"energy":24},"planning_model":{"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"gu","facet":"doc","field":"self_directed_today"},"value":true},{"op":"known","ref":{"type":"ref","object":"gu","facet":"doc","field":"professional_memory"}}]},"effects":{"schemes.doc.gu_index_accepted":true},"cost":1.0,"uncertainty_cost":0},"public_completion_text":"顾平章：沃德同意留来源和异议。我只替索引署名，不替每一位发言者担保；读者还须回到那个人面前去问。","tell":[{"actor":"ward","room":"F03","results":["schemes.doc.gu_index_accepted","schemes.doc.gu_index_accepted_text"]},{"actor":"quer","room":"F03","results":["schemes.doc.gu_index_accepted","schemes.doc.gu_index_accepted_text"]},{"actor":"ruan","room":"F03","results":["schemes.doc.gu_index_accepted","schemes.doc.gu_index_accepted_text"]}]},
        {"id":"gu.scheme.gu_parallel_index","label":"不同意改总簿时另立公开的来源对照页","kind":"interact","at":"F03","focus":"F03-table","interaction_slot":"F03-table","once":true,"minutes":3,"priority":0,"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"gu","facet":"doc","field":"self_directed_today"},"value":true},{"op":"equals","ref":{"type":"ref","object":"gu","facet":"phys","field":"asleep"},"value":false},{"op":"equals","ref":{"type":"ref","object":"ward","facet":"doc","field":"scheme_source_index_consent"},"value":false}]},"writes":{"schemes.doc.gu_parallel_index":true,"schemes.doc.gu_parallel_index_text":"顾平章：总簿暂不肯留这些栏，我就在旁边另写一页。两页并放，谁愿意合并，先把删掉哪句、凭什么删说清楚。"},"observes":["schemes.doc.gu_parallel_index","schemes.doc.gu_parallel_index_text"],"tags":["自主安排","职业经验"],"need_above":{"energy":24},"planning_model":{"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"gu","facet":"doc","field":"self_directed_today"},"value":true},{"op":"known","ref":{"type":"ref","object":"gu","facet":"doc","field":"professional_memory"}}]},"effects":{"schemes.doc.gu_parallel_index":true},"cost":1.0,"uncertainty_cost":0},"public_completion_text":"顾平章：总簿暂不肯留这些栏，我就在旁边另写一页。两页并放，谁愿意合并，先把删掉哪句、凭什么删说清楚。","tell":[{"actor":"ward","room":"F03","results":["schemes.doc.gu_parallel_index","schemes.doc.gu_parallel_index_text"]},{"actor":"quer","room":"F03","results":["schemes.doc.gu_parallel_index","schemes.doc.gu_parallel_index_text"]},{"actor":"ruan","room":"F03","results":["schemes.doc.gu_parallel_index","schemes.doc.gu_parallel_index_text"]}]},
        {"id":"gu.scheme.compare_teaching_scope","label":"把听到的规则范围与提案中的授权范围逐项比较","kind":"interact","at":"F03","focus":"gu","interaction_slot":"gu","once":true,"minutes":3,"priority":0,"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"gu","facet":"doc","field":"self_directed_today"},"value":true},{"op":"equals","ref":{"type":"ref","object":"gu","facet":"phys","field":"asleep"},"value":false},{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"schemes","facet":"doc","field":"gu_source_rules"},"value":true},{"op":"known","ref":{"type":"ref","object":"lecture","facet":"doc","field":"scope_lesson"}}]}]},"writes":{"gu.doc.scheme_teaching_scope_applied":true},"observes":["gu.doc.scheme_teaching_scope_applied"],"tags":["自主安排","职业经验"],"need_above":{"energy":24},"planning_model":{"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"gu","facet":"doc","field":"self_directed_today"},"value":true},{"op":"known","ref":{"type":"ref","object":"gu","facet":"doc","field":"professional_memory"}}]},"effects":{"gu.doc.scheme_teaching_scope_applied":true},"cost":1.0,"uncertainty_cost":0},"completion_text":"如果规则只能在明确范围内生效，人们写出的授权更不该越过本人说过的界线。授课者的话也要注明来源，不能变成新的神谕。"},
        {"id":"gu.scheme.gu_scope_constraint","label":"引用实际听到的范围说明，要求授权同样注明边界","kind":"interact","at":"F03","focus":"F03-table","interaction_slot":"F03-table","once":true,"minutes":3,"priority":0,"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"gu","facet":"doc","field":"self_directed_today"},"value":true},{"op":"equals","ref":{"type":"ref","object":"gu","facet":"phys","field":"asleep"},"value":false},{"op":"equals","ref":{"type":"ref","object":"gu","facet":"doc","field":"scheme_teaching_scope_applied"},"value":true},{"op":"equals","ref":{"type":"ref","object":"schemes","facet":"doc","field":"quer_terms"},"value":true}]},"writes":{"schemes.doc.gu_scope_constraint":true,"schemes.doc.gu_scope_constraint_text":"顾平章：我从授课中听到的是范围，不是全知的保证。把这点借回来问我们自己：一页记录的授权，到哪里止？过了那条线，再响亮的名字也不算新的同意。"},"observes":["schemes.doc.gu_scope_constraint","schemes.doc.gu_scope_constraint_text"],"tags":["自主安排","职业经验"],"need_above":{"energy":24},"planning_model":{"when":{"op":"all","items":[{"op":"equals","ref":{"type":"ref","object":"gu","facet":"doc","field":"self_directed_today"},"value":true},{"op":"known","ref":{"type":"ref","object":"gu","facet":"doc","field":"professional_memory"}}]},"effects":{"schemes.doc.gu_scope_constraint":true},"cost":1.0,"uncertainty_cost":0},"public_completion_text":"顾平章：我从授课中听到的是范围，不是全知的保证。把这点借回来问我们自己：一页记录的授权，到哪里止？过了那条线，再响亮的名字也不算新的同意。","tell":[{"actor":"ward","room":"F03","results":["schemes.doc.gu_scope_constraint","schemes.doc.gu_scope_constraint_text"]},{"actor":"quer","room":"F03","results":["schemes.doc.gu_scope_constraint","schemes.doc.gu_scope_constraint_text"]},{"actor":"ruan","room":"F03","results":["schemes.doc.gu_scope_constraint","schemes.doc.gu_scope_constraint_text"]}]}
