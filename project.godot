; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="安眠者有福 · 五人生活推演"
run/main_scene="res://scenes/main/Boot.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[audio]

buses/default_bus_layout="res://assets/audio/default_bus_layout.tres"

[autoload]

BuildingMcp="*res://mcp/building/GodotControl.gd"
GameMcp="*res://mcp/game/GameControl.gd"
GameAudio="*res://scenes/components/shared/GameAudio.gd"
GameSettings="*res://scenes/components/shared/GameSettings.gd"
GameLocale="*res://scenes/components/shared/LocaleSettings.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="DualOntologyWorldReconstruct2"

[editor_plugins]

enabled=PackedStringArray("res://tools/building_construction/plugin.cfg")

