config_version=5

[application]
config/name="The Sleeping Academy"
run/main_scene="res://scenes/rogue/Run.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[autoload]
GameMcp="*res://mcp/game/GameControl.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[dotnet]
project/assembly_name="DualOntologyWorldReconstruct2"

[rendering]
renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.04, 0.06, 0.07, 1)
